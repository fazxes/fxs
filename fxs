def register_signing_pub_on_github(pub_line):
    if not shutil.which("gh"):
        return False
    pub_key_only = " ".join(pub_line.strip().split()[:2])
    chk = subprocess.run(
        ["gh", "api", "user/ssh_signing_keys", "--paginate", "--jq", ".[].key"],
        capture_output=True, text=True,
    )
    if chk.returncode == 0:
        existing = [" ".join(l.strip().split()[:2]) for l in chk.stdout.splitlines() if l.strip()]
        if pub_key_only in existing:
            say("signing key is already registered on GitHub")
            return True
        with tempfile.TemporaryDirectory() as tmp:
            kf = Path(tmp) / "fxs_signing.pub"
            kf.write_text(pub_line.strip() + "\n")
            add = subprocess.run(
                ["gh", "ssh-key", "add", str(kf), "--type", "signing", "--title", "fxs sandbox"],
                capture_output=True, text=True,
            )
            if add.returncode == 0:
                say("added signing key to GitHub")
                return True
    return False


def cmd_signing_setup(args):
    cfg = require_config()
    sb_name, rest = parse_flag(args, "--sandbox", has_value=True)
    if rest:
        die("usage: fxs signing-setup [--sandbox NAME]", 2)

    if sb_name:
        p = remote_exec(cfg, sb_name, SIGNING_SETUP_SCRIPT, capture=True)
        pub = ""
        for line in p.stdout.splitlines():
            if line.startswith("FXS_SIGNING_PUB|"):
                pub = line.split("|", 1)[1].strip()
        if pub and not register_signing_pub_on_github(pub):
            say("add this public key on GitHub as Key type = 'Signing Key' (https://github.com/settings/ssh/new):")
            print(pub)
        return

    with file_lock(CACHE_DIR / "base.lock"):
        base = ensure_base(cfg)
        tmp_sb = "fxs-sign-" + uuid.uuid4().hex[:6]
        say(f"configuring SSH commit signing in base snapshot {base['snapshot']}")
        run_vc(cfg, "create", "--name", tmp_sb, "--snapshot", base["snapshot"], "--vcpus", "2", "--timeout", "10m", capture=True)
        try:
            p = remote_exec(cfg, tmp_sb, SIGNING_SETUP_SCRIPT, capture=True)
            pub = ""
            for line in p.stdout.splitlines():
                if line.startswith("FXS_SIGNING_PUB|"):
                    pub = line.split("|", 1)[1].strip()
            remote_exec(cfg, tmp_sb, r'''set -euo pipefail
d=$(mktemp -d)
cd "$d"
git init -q
git config user.name >/dev/null 2>&1 || git config user.name "fxs"
git config user.email >/dev/null 2>&1 || git config user.email "sandbox@localhost"
echo ok > f && git add f
git commit -q -m "verify signing"
sig=$(git log -1 --format="%G?")
rm -rf "$d"
[ "$sig" = "G" ]
''', capture=True)
            snap = run_vc(cfg, "snapshot", "--stop", "--expiration", "0", tmp_sb, capture=True)
            m = re.search(r"snap_[A-Za-z0-9]+", snap.stdout + snap.stderr)
            if not m:
                die("could not find snapshot ID in output")
            base["snapshot"] = m.group(0)
            base["created"] = time.time()
            write_json(BASE_FILE, base)
            say(f"base snapshot {base['snapshot']} updated with SSH commit signing")
            if pub and not register_signing_pub_on_github(pub):
                say("add this public key on GitHub as Key type = 'Signing Key' (https://github.com/settings/ssh/new):")
                print(pub)
        finally:
            subprocess.run(vc_args(cfg, "rm", tmp_sb), capture_output=True)


def cmd_new(args):
    cfg = require_config()
    flags, agent_args = split_passthrough(args)
    name, flags = parse_flag(flags, "--name", has_value=True)
    agent_name, flags = parse_flag(flags, "--agent", has_value=True)
    do_split, flags = parse_flag(flags, "--split", has_value=False)
    want_ssh, flags = parse_flag(flags, "--ssh", has_value=False)
    vcpus, flags = parse_flag(flags, "--vcpus", has_value=True)
    timeout, flags = parse_flag(flags, "--timeout", has_value=True)
    if flags:
        die(f"unknown flags: {' '.join(flags)}", 2)

    agent_name = agent_name or cfg.get("default_agent", "fx")
    get_shim(agent_name, cfg)

    if do_split:
        return spawn_split(cfg, agent_name, agent_args)

    base = ensure_base(cfg)
    if agent_name not in (base.get("agents") or []):
        say(f"agent '{agent_name}' is not in the current base snapshot; installing on boot (run `fxs base --agents {','.join(sorted(set((base.get('agents') or []) + [agent_name])))}` to bake it in)")

    name = name or ("fxs-" + uuid.uuid4().hex[:6])
    say(f"starting {name} ({agent_name}) from {base['snapshot']}")
    run_vc(
        cfg, "create",
        "--name", name,
        "--snapshot", base["snapshot"],
        "--vcpus", str(vcpus or cfg.get("vcpus", "8")),
        "--timeout", timeout or cfg.get("timeout", "6h"),
        "--tag", "fxs=1",
        capture=True,
    )
    sync_profile_if_needed(cfg, name, base.get("profile_hash"))
    if agent_name not in (base.get("agents") or []):
        shim = get_shim(agent_name, cfg)
        remote_exec(cfg, name, f"set -e; {shim.install_cmd}", interactive=sys.stdin.isatty())
    if (TAILSCALE_KEY_FILE.exists() or want_ssh) and not os.environ.get("FXS_NO_TAILSCALE"):
        start_sandbox_tailscale(cfg, name, interactive_if_no_key=want_ssh)
    run_agent_loop(cfg, name, agent_name, agent_args, continue_first=False)


def rex_json(*args):
    p = subprocess.run(["rex", *args, "--json"], capture_output=True, text=True)
    if p.returncode != 0:
        sys.stderr.write(p.stderr)
        die(f"rex {' '.join(args)} failed")
    return json.loads(p.stdout)


def focus_rex_session_in_app(session_id):
    p = subprocess.run(["rex", "client", "ls", "--json"], capture_output=True, text=True)
    if p.returncode != 0:
        return
    try:
        clients = json.loads(p.stdout).get("clients", [])
    except Exception:
        return
    for c in clients:
        if c.get("info", {}).get("kind") == "app":
            subprocess.run(
                ["rex", "-C", c["client_id"], "do", "session.select", f"session_id={session_id}"],
                capture_output=True,
            )
            break


def spawn_split(cfg, agent_name, agent_args):
    if not shutil.which("rex"):
        die("rex CLI not found")
    session = os.environ.get("REX_SESSION")
    block = os.environ.get("REX_BLOCK")
    if not session or not block:
        die("--split must be run inside a Rex pane")
    ensure_base(cfg)
    cmd = ["rex", "split", "-s", session, "-b", block, "--split=right", "--", str(Path(__file__).resolve()), "--agent", agent_name]
    if agent_args:
        cmd.extend(["--", *agent_args])
    subprocess.check_call(cmd)


def cmd_group(args):
    cfg = require_config()
    if not shutil.which("rex"):
        die("rex CLI not found")
    flags, agent_args = split_passthrough(args)
    ws_label, flags = parse_flag(flags, "--workspace", has_value=True)
    new_ws, flags = parse_flag(flags, "-w", has_value=False)
    agent_name, flags = parse_flag(flags, "--agent", has_value=True)
    if len(flags) != 1 or not flags[0].isdigit() or int(flags[0]) < 1:
        die("usage: fxs group <count> [--workspace LABEL] [--agent NAME] [-- <args...>]", 2)
    count = int(flags[0])
    agent_name = agent_name or cfg.get("default_agent", "fx")
    get_shim(agent_name, cfg)
    ensure_base(cfg)

    child_cmd = [str(Path(__file__).resolve()), "--agent", agent_name] + (["--", *agent_args] if agent_args else [])
    session = os.environ.get("REX_SESSION")
    if ws_label or new_ws or not session:
        res = rex_json("new", ws_label or "fxs", "--window", "sandboxes", "--", *child_cmd)
        session = res["session_id"]
        first_block = res["initial_windows"][0]["block_ids"][0]
        focus_rex_session_in_app(session)
    else:
        res = rex_json("window", "new", "-s", session, "sandboxes", "--", *child_cmd)
        first_block = res["block_ids"][0]

    if count == 2:
        rex_json("split", "-s", session, "-b", first_block, "--split=right", "--ratio", "50", "--", *child_cmd)
    elif count == 3:
        b2 = rex_json("split", "-s", session, "-b", first_block, "--split=right", "--ratio", "67", "--", *child_cmd)["block_ids"][0]
        rex_json("split", "-s", session, "-b", b2, "--split=right", "--ratio", "50", "--", *child_cmd)
    elif count == 4:
        b2 = rex_json("split", "-s", session, "-b", first_block, "--split=right", "--ratio", "50", "--", *child_cmd)["block_ids"][0]
        rex_json("split", "-s", session, "-b", first_block, "--split=below", "--ratio", "50", "--", *child_cmd)
        rex_json("split", "-s", session, "-b", b2, "--split=below", "--ratio", "50", "--", *child_cmd)
    elif count > 4:
        anchor = first_block
        for i in range(1, count):
            direction = "right" if i % 2 == 1 else "below"
            anchor = rex_json("split", "-s", session, "-b", anchor, f"--split={direction}", "--", *child_cmd)["block_ids"][0]
    say(f"opened {count} sandbox panes ({agent_name}) in Rex session {session}")


def mcp_login_one(cfg, sandbox_name, server_name):
    say(f"starting MCP OAuth login for {server_name} in {sandbox_name}")
    proc = subprocess.Popen(
        vc_args(cfg, "exec", sandbox_name, "--", "bash", "-lc", f"~/.local/bin/fx mcp login --no-browser {shlex.quote(server_name)}"),
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1,
    )
    servers = []
    opened = False

    def start_forwarder(port):
        class Handler(http.server.BaseHTTPRequestHandler):
            def do_GET(self):
                target = f"http://127.0.0.1:{port}{self.path}"
                p = subprocess.run(vc_args(cfg, "exec", sandbox_name, "--", "curl", "-fsS", target), capture_output=True, text=True)
                body = (p.stdout or "Login sent to sandbox. You can close this tab.").encode()
                self.send_response(200 if p.returncode == 0 else 502)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def log_message(self, *_args):
                pass

        class IPv4Server(http.server.HTTPServer):
            allow_reuse_address = True

        class IPv6Server(http.server.HTTPServer):
            address_family = socket.AF_INET6
            allow_reuse_address = True

        for cls, host in ((IPv4Server, "127.0.0.1"), (IPv6Server, "::1")):
            try:
                srv = cls((host, port), Handler)
                servers.append(srv)
                threading.Thread(target=srv.serve_forever, daemon=True).start()
            except OSError:
                pass

    try:
        for line in proc.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            if not opened:
                m = re.search(r"https://[^\s]+", line)
                if m:
                    auth_url = m.group(0)
                    qs = urllib.parse.parse_qs(urllib.parse.urlparse(auth_url).query)
                    redir = (qs.get("redirect_uri") or [""])[0]
                    rm = re.search(r"http://(?:localhost|127\.0\.0\.1):(\d+)", redir)
                    if rm:
                        start_forwarder(int(rm.group(1)))
                    opened = True
                    if shutil.which("open"):
                        subprocess.run(["open", auth_url], capture_output=True)
        rc = proc.wait()
    finally:
        for srv in servers:
            srv.shutdown()
            srv.server_close()
    if rc != 0:
        die(f"fx mcp login {server_name} failed (exit {rc})")


def cmd_mcp_login(args):
    cfg = require_config()
    sb_name, rest = parse_flag(args, "--sandbox", has_value=True)
    if not rest:
        die("usage: fxs mcp-login <server...> [--sandbox NAME]", 2)
    if sb_name:
        for s in rest:
            mcp_login_one(cfg, sb_name, s)
        return

    with file_lock(CACHE_DIR / "base.lock"):
        base = ensure_base(cfg)
        tmp_sb = "fxs-mcplogin-" + uuid.uuid4().hex[:6]
        say(f"booting temporary base sandbox {tmp_sb} to save MCP logins")
        run_vc(cfg, "create", "--name", tmp_sb, "--snapshot", base["snapshot"], "--vcpus", "2", "--timeout", "15m", capture=True)
        try:
            sync_profile_if_needed(cfg, tmp_sb, base.get("profile_hash"))
            for s in rest:
                mcp_login_one(cfg, tmp_sb, s)
            p = run_vc(cfg, "snapshot", "--stop", "--expiration", "0", tmp_sb, capture=True)
            m = re.search(r"snap_[A-Za-z0-9]+", p.stdout + p.stderr)
            if not m:
                die("could not find snapshot ID in output")
            base["snapshot"] = m.group(0)
            base["created"] = time.time()
            with tempfile.TemporaryDirectory() as tmp:
                _, base["profile_hash"] = build_profile_bundle(tmp, cfg)
            write_json(BASE_FILE, base)
            say(f"base snapshot {base['snapshot']} updated with MCP logins")
        finally:
            subprocess.run(vc_args(cfg, "rm", tmp_sb), capture_output=True)


