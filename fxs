p = subprocess.run(["tailscale", f"--socket={sock}", "status", "--json"], stdin=subprocess.DEVNULL, capture_output=True, text=True)
if p.returncode != 0:
    print("fxs-pick: tailscale is not running in this sandbox", file=sys.stderr)
    sys.exit(1)

d = json.loads(p.stdout)
self_node = d.get("Self") or {}
nodes = [self_node] + list((d.get("Peer") or {}).values())

def sort_key(n):
    h = (n.get("HostName") or "").lower()
    m = re.fullmatch(r"fxs-(\d+)", h)
    return (0, int(m.group(1)), h) if m else (1, 0, h)

def probe(item):
    hn, online, ip4, dns, is_self = item
    if not online:
        return (hn, "offline", "", ip4, dns, is_self)
    try:
        if is_self:
            r = subprocess.run(["/usr/local/bin/fxs-info"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=3)
        else:
            r = subprocess.run(
                ["tailscale", f"--socket={sock}", "ssh", f"ubuntu@{hn}", "/usr/local/bin/fxs-info"],
                stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5,
            )
        if r.returncode == 0 and r.stdout.strip():
            info = json.loads(r.stdout.strip().splitlines()[-1])
            return (hn, info.get("state") or "online", info.get("title") or "", ip4, dns, is_self)
    except Exception:
        pass
    return (hn, "online", "", ip4, dns, is_self)

raw_items = []
for n in sorted(nodes, key=sort_key):
    hn = n.get("HostName") or ""
    if not hn.startswith("fxs-"):
        continue
    online = bool(n.get("Online", n is self_node))
    ips = n.get("TailscaleIPs") or []
    ip4 = next((x for x in ips if "." in x), "?")
    dns = (n.get("DNSName") or "").rstrip(".")
    raw_items.append((hn, online, ip4, dns, n is self_node))

if not raw_items:
    print("No fxs sandboxes found on Tailscale.")
    sys.exit(0)

with ThreadPoolExecutor(max_workers=min(12, len(raw_items))) as ex:
    items = list(ex.map(probe, raw_items))

for i, (hn, st, title, ip4, dns, is_self) in enumerate(items, 1):
    tag = " *" if is_self else ""
    label = title or dns or ip4
    print(f"  {i:3d}. {hn:<12} [{st:<7}]  {label}{tag}")

ans = input("\nPick number or search title (Enter = attach here): ").strip()
if not ans:
    os.execvp("/usr/local/bin/fxs-attach", ["/usr/local/bin/fxs-attach"])

chosen = None
if ans.isdigit() and 1 <= int(ans) <= len(items):
    chosen = items[int(ans) - 1]
else:
    q = ans.lower()
    matches = [it for it in items if q in it[0].lower() or q in it[2].lower()]
    if len(matches) == 1:
        chosen = matches[0]
    elif len(matches) > 1:
        for i, (hn, st, title, ip4, dns, is_self) in enumerate(matches, 1):
            print(f"  {i}. {hn:<12} [{st:<7}]  {title or dns}")
        sub = input("Pick match [1]: ").strip() or "1"
        if sub.isdigit() and 1 <= int(sub) <= len(matches):
            chosen = matches[int(sub) - 1]

if not chosen:
    print("No matching sandbox", file=sys.stderr)
    sys.exit(2)

hn, _st, _title, _ip4, _dns, is_self = chosen
if is_self:
    os.execvp("/usr/local/bin/fxs-attach", ["/usr/local/bin/fxs-attach"])
os.execvp("tailscale", ["tailscale", f"--socket={sock}", "ssh", f"ubuntu@{hn}", "-t", "fxs-attach"])
FXP
sudo chmod 755 /usr/local/bin/fxs-pick
'''.strip())

    if git_name:
