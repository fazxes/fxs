def load_custom_shims():
    shims = {}
    if not CUSTOM_AGENTS_DIR.is_dir():
        return shims
    for p in sorted(CUSTOM_AGENTS_DIR.glob("*.json")):
        try:
            d = json.loads(p.read_text())
            name = d.get("name") or p.stem
            shims[name] = AgentShim(
                name=name,
                description=d.get("description", f"Custom shim ({name})"),
                bin_path=d["bin_path"],
                install_cmd=d.get("install_cmd", "true"),
                auth_check_cmd=d.get("auth_check_cmd", "true"),
                auth_login_cmd=d.get("auth_login_cmd", "true"),
                skills_dir=d.get("skills_dir", ".agents/skills"),
                session_subdir=d.get("session_subdir", ""),
                supports_session_sync=bool(d.get("supports_session_sync", False)),
                extra_env=d.get("extra_env") or {},
                resume_flag=d.get("resume_flag", "--resume"),
                continue_flag=d.get("continue_flag", "--continue"),
                subcommand_resume=bool(d.get("subcommand_resume", False)),
            )
        except Exception as e:
            say(f"warning: skipping invalid custom shim {p}: {e}")
    return shims


def all_shims(cfg=None):
    shims = builtin_shims(cfg)
    shims.update(load_custom_shims())
    return shims


def get_shim(name, cfg=None):
    shims = all_shims(cfg)
    if name not in shims:
        die(f"unknown agent '{name}'. Available: {', '.join(sorted(shims))}", 2)
    return shims[name]


def say(msg):
    print(f"fxs: {msg}", file=sys.stderr, flush=True)


def die(msg, code=1):
    say(msg)
    sys.exit(code)


def read_json(path, default):
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(path)


@contextlib.contextmanager
def file_lock(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)


def read_config():
    return read_json(CONFIG_FILE, {})


def require_config():
    cfg = read_config()
    if cfg.get("team") and cfg.get("project"):
        return cfg
    if sys.stdin.isatty():
        say("no fxs config found yet; starting onboarding")
        cmd_init([])
        cfg = read_config()
        if cfg.get("team") and cfg.get("project"):
            return cfg
    die("fxs is not configured yet. Run: fxs init --team <team> --project <project>", 2)


def vc_args(cfg, sub, *args):
    cmd = ["vercel", "sandbox", sub]
    if cfg.get("team"):
        cmd.extend(["--scope", cfg["team"]])
    if cfg.get("project"):
        cmd.extend(["--project", cfg["project"]])
    cmd.extend(args)
    return cmd


def run_vc(cfg, sub, *args, check=True, capture=False):
    cmd = vc_args(cfg, sub, *args)
    if capture:
        p = subprocess.run(cmd, capture_output=True, text=True)
        if check and p.returncode != 0:
            sys.stderr.write((p.stdout + p.stderr)[-3000:])
            die(f"vercel sandbox {sub} failed (exit {p.returncode})")
        return p
    rc = subprocess.call(cmd)
    if check and rc != 0:
        die(f"vercel sandbox {sub} failed (exit {rc})")
    return rc


IMAGE_PASTE_RE = re.compile(r"(/[^\r\n\"'<>\x1b]+?\.(?:png|jpe?g|webp|gif))", re.IGNORECASE)


def extract_local_image_paths(data_bytes):
    text = data_bytes.decode("utf-8", "ignore").replace("\\ ", " ")
    found = []
    for m in IMAGE_PASTE_RE.finditer(text):
        p = m.group(1)
        if os.path.isfile(p) and p not in found:
            found.append(p)
    return found


def sync_pasted_images(cfg, name, paths, uploaded_cache):
    to_send = []
    for p in paths:
        try:
            mt = os.path.getmtime(p)
        except OSError:
            continue
        if uploaded_cache.get(p) == mt:
            continue
        to_send.append((p, mt))
    if not to_send:
        return
    parents = sorted({os.path.dirname(p) for p, _ in to_send})
    mk = " && ".join(f"sudo mkdir -p {shlex.quote(d)} && sudo chown $(id -u):$(id -g) {shlex.quote(d)}" for d in parents)
    subprocess.run(vc_args(cfg, "exec", name, "--", "bash", "-lc", mk), capture_output=True)
    for p, mt in to_send:
        cp = subprocess.run(vc_args(cfg, "copy", p, f"{name}:{p}"), capture_output=True)
        if cp.returncode == 0:
            uploaded_cache[p] = mt


def run_interactive_with_image_sync(cfg, name, script):
    cmd = vc_args(cfg, "exec", "-i", *TERM_ENV, name, "--", "bash", "-lc", script)
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return subprocess.call(cmd)

    in_fd = sys.stdin.fileno()
    out_fd = sys.stdout.fileno()
    old_tty = termios.tcgetattr(in_fd)
    master_fd, slave_fd = pty.openpty()

    def sync_winsize():
        try:
            ws = fcntl.ioctl(in_fd, termios.TIOCGWINSZ, b"\x00" * 8)
            fcntl.ioctl(master_fd, termios.TIOCSWINSZ, ws)
        except OSError:
            pass

    sync_winsize()
    prev_winch = signal.getsignal(signal.SIGWINCH)
    signal.signal(signal.SIGWINCH, lambda *_: sync_winsize())

    proc = subprocess.Popen(cmd, stdin=slave_fd, stdout=slave_fd, stderr=slave_fd, close_fds=True)
    os.close(slave_fd)

    uploaded_cache = {}
    paste_buf = bytearray()
    in_paste = False
    paste_deadline = 0.0

    def write_all(fd, data):
        view = memoryview(data)
        while view:
            n = os.write(fd, view)
            view = view[n:]

    def flush_paste():
        nonlocal in_paste
        raw = bytes(paste_buf)
        paste_buf.clear()
        in_paste = False
        imgs = extract_local_image_paths(raw)
        if imgs:
            sync_pasted_images(cfg, name, imgs, uploaded_cache)
        write_all(master_fd, raw)

    try:
        tty.setraw(in_fd)
        while True:
            timeout = max(0.0, paste_deadline - time.monotonic()) if in_paste else None
            rlist = [master_fd] if proc.poll() is not None else [in_fd, master_fd]
            try:
                ready, _, _ = select.select(rlist, [], [], timeout)
            except InterruptedError:
                continue
            if in_paste and not ready:
                flush_paste()
                continue
            if master_fd in ready:
                try:
                    out = os.read(master_fd, 16384)
                except OSError:
                    out = b""
                if not out:
                    break
                write_all(out_fd, out)
            if in_fd in ready:
                try:
                    chunk = os.read(in_fd, 4096)
                except OSError:
                    chunk = b""
                if not chunk:
                    break
                if in_paste:
                    paste_buf.extend(chunk)
                    if b"\x1b[201~" in paste_buf:
                        flush_paste()
                elif b"\x1b[200~" in chunk:
                    in_paste = True
                    paste_buf.extend(chunk)
                    paste_deadline = time.monotonic() + 0.15
                    if b"\x1b[201~" in paste_buf:
                        flush_paste()
                else:
                    imgs = extract_local_image_paths(chunk)
                    if imgs:
                        sync_pasted_images(cfg, name, imgs, uploaded_cache)
                    write_all(master_fd, chunk)
        return proc.wait()
    finally:
        signal.signal(signal.SIGWINCH, prev_winch)
        with contextlib.suppress(OSError):
            os.close(master_fd)
        termios.tcsetattr(in_fd, termios.TCSADRAIN, old_tty)


def remote_exec(cfg, name, script, interactive=False, env=None, workdir=None, check=True, capture=False):
    args = []
    if interactive:
        args.append("-i")
    if workdir:
        args.extend(["-w", workdir])
    for e in (env or []):
        args.extend(["-e", e] if "=" in e and not e.startswith("-") else [e])
    if interactive:
        args.extend(TERM_ENV)
    args.extend([name, "--", "bash", "-lc", script])
    cmd = vc_args(cfg, "exec", *args)
    if capture:
        p = subprocess.run(cmd, capture_output=True, text=True)
        if check and p.returncode != 0:
            sys.stderr.write((p.stdout + p.stderr)[-3000:])
            die(f"sandbox command failed (exit {p.returncode})")
        return p
    rc = subprocess.call(cmd)
    if check and rc != 0:
        die(f"sandbox command failed (exit {rc})")
    return rc


def parse_flag(args, name, has_value=False):
    out = []
    val = None
    found = False
    i = 0
    while i < len(args):
        if args[i] == "--":
            out.extend(args[i:])
            break
        if args[i] == name:
            found = True
            if has_value:
                if i + 1 >= len(args):
                    die(f"{name} requires a value", 2)
                val = args[i + 1]
                i += 2
                continue
            i += 1
            continue
        out.append(args[i])
        i += 1
    return (val if has_value else found), out


def parse_multi_flag(args, name):
    out = []
    vals = []
    i = 0
    while i < len(args):
        if args[i] == "--":
            out.extend(args[i:])
            break
        if args[i] == name:
            if i + 1 >= len(args):
                die(f"{name} requires a value", 2)
            vals.append(args[i + 1])
            i += 2
            continue
        out.append(args[i])
        i += 1
    return vals, out


def split_passthrough(args):
    if "--" in args:
        idx = args.index("--")
        return args[:idx], args[idx + 1:]
    return args, []


def sanitize_fx_settings(raw_text):
    data = json.loads(raw_text)
    data.pop("workspaces", None)
    data["sandbox"] = "none"
    return json.dumps(data, indent=2) + "\n"


def filter_mcp_json(raw_text, allowed_servers=None):
    mcp_data = json.loads(raw_text)
    servers = mcp_data.get("mcp") or {}
    allow = set(allowed_servers) if allowed_servers is not None else None
    http_only = {
        k: v for k, v in servers.items()
        if isinstance(v, dict)
        and v.get("type") == "http"
        and (allow is None or k in allow)
    }
    if not http_only:
        return None
    return json.dumps({"mcp": http_only}, indent=2) + "\n"


def add_skills_tree(tar, src_root, arc_prefix):
    if not src_root.is_dir():
        return
    for entry in sorted(src_root.iterdir()):
        if entry.name in SKILL_SKIP:
            continue
        resolved_dir = entry.resolve() if entry.is_symlink() else entry
        if not resolved_dir.is_dir() or not (resolved_dir / "SKILL.md").is_file():
            continue
        for dirpath, dirnames, filenames in os.walk(resolved_dir, followlinks=True):
            dirnames[:] = sorted(d for d in dirnames if d not in SKILL_SKIP)
            for fn in sorted(filenames):
                if fn in SKILL_SKIP:
                    continue
                fp = Path(dirpath) / fn
                if not fp.is_file():
                    continue
                rel = fp.relative_to(resolved_dir)
                arc = f"{arc_prefix}/{entry.name}/{rel.as_posix()}"
                raw = fp.read_bytes()
                ti = tarfile.TarInfo(arc)
                ti.size = len(raw)
                ti.mode = fp.stat().st_mode & 0o755 | 0o644
                tar.addfile(ti, io.BytesIO(raw))


def build_profile_bundle(tmp_dir, cfg):
    """Package user agent configs, themes, instruction files, and HTTP MCP config."""
    tgz = Path(tmp_dir) / "fxs-profile.tgz"
    h = hashlib.sha256()

    def add_bytes(arc, raw_bytes, mode=0o644):
        h.update(arc.encode() + b"\0" + raw_bytes)
        ti = tarfile.TarInfo(arc)
        ti.size = len(raw_bytes)
        ti.mode = mode
        tar.addfile(ti, io.BytesIO(raw_bytes))

    with tarfile.open(tgz, "w:gz") as tar:
        fx_dir = HOME / ".fx"
        if (fx_dir / "settings.json").is_file():
            try:
                add_bytes(".fx/settings.json", sanitize_fx_settings((fx_dir / "settings.json").read_text()).encode(), 0o600)
            except Exception:
                pass
        if (fx_dir / "themes").is_dir():
            for p in sorted((fx_dir / "themes").iterdir()):
                if p.is_file():
                    add_bytes(f".fx/themes/{p.name}", p.read_bytes(), 0o644)
        if (fx_dir / "AGENTS.md").is_file():
            add_bytes(".fx/AGENTS.md", (fx_dir / "AGENTS.md").read_bytes(), 0o644)
        mcp_servers = cfg.get("mcp_servers")
        if mcp_servers != [] and (fx_dir / "mcp.json").is_file():
            try:
                filtered = filter_mcp_json((fx_dir / "mcp.json").read_text(), mcp_servers)
                if filtered:
                    add_bytes(".fx/mcp.json", filtered.encode(), 0o600)
            except Exception:
                pass

        for src_rel in (".claude/settings.json", ".claude/CLAUDE.md", ".codex/config.toml", ".codex/AGENTS.md"):
            p = HOME / src_rel
            if p.is_file():
                add_bytes(src_rel, p.read_bytes(), 0o600 if src_rel.endswith(".json") else 0o644)

        opencode_cfg = HOME / ".config" / "opencode"
        if opencode_cfg.is_dir():
            for p in sorted(opencode_cfg.rglob("*")):
                if p.is_file() and not any(part in SKILL_SKIP for part in p.parts) and p.name != "skills":
                    if "skills" in p.relative_to(opencode_cfg).parts:
                        continue
                    add_bytes(p.relative_to(HOME).as_posix(), p.read_bytes(), 0o644)

    return tgz, h.hexdigest()[:16]


def build_skills_bundle(tmp_dir):
    tgz = Path(tmp_dir) / "fxs-skills.tgz"
    with tarfile.open(tgz, "w:gz") as tar:
        for root_rel in (".fx/skills", ".agents/skills", ".claude/skills", ".codex/skills", ".config/opencode/skills"):
            add_skills_tree(tar, HOME / root_rel, root_rel)
    return tgz


def local_git_identity():
    name = subprocess.run(["git", "config", "--global", "user.name"], capture_output=True, text=True).stdout.strip()
    email = subprocess.run(["git", "config", "--global", "user.email"], capture_output=True, text=True).stdout.strip()
    return name, email


def sandbox_exists(cfg, name):
    p = subprocess.run(vc_args(cfg, "ls", "--name-prefix", name), capture_output=True, text=True)
    if p.returncode != 0:
        return False
    return any(line.split()[:1] == [name] for line in p.stdout.splitlines())


def export_creds_from(cfg, src_sandbox, tmp_dir):
    if not src_sandbox or not sandbox_exists(cfg, src_sandbox):
        return None
    say(f"carrying over CLI logins from {src_sandbox}")
    p = subprocess.run(
        vc_args(
            cfg, "exec", src_sandbox, "--", "bash", "-lc",
            "cd ~ && files=(); "
            "for f in .fx/auth.json .claude/.credentials.json .claude.json .codex/auth.json "
            ".config/gh/hosts.yml .config/gh/config.yml; do "
            "  [ -f \"$f\" ] && files+=(\"$f\"); "
            "done; "
            "[ ${#files[@]} -gt 0 ] && tar -czf /tmp/fxs-creds.tgz \"${files[@]}\" && echo OK",
        ),
        capture_output=True, text=True,
    )
    if p.returncode != 0 or "OK" not in p.stdout:
        return None
    local_tgz = Path(tmp_dir) / "fxs-creds.tgz"
    cp = subprocess.run(
        vc_args(cfg, "copy", f"{src_sandbox}:/tmp/fxs-creds.tgz", str(local_tgz)),
        capture_output=True, text=True,
    )
    subprocess.run(vc_args(cfg, "exec", src_sandbox, "--", "rm", "-f", "/tmp/fxs-creds.tgz"), capture_output=True)
    return local_tgz if cp.returncode == 0 and local_tgz.exists() else None


def vercel_logged_in():
    p = subprocess.run(["vercel", "whoami"], capture_output=True, text=True)
    return p.returncode == 0, p.stdout.strip()


def discover_teams():
    p = subprocess.run(["vercel", "teams", "ls"], capture_output=True, text=True)
    if p.returncode != 0:
        return []
    teams = []
    for line in p.stdout.splitlines():
        line = line.strip()
        if not line or line.startswith("id ") or line.startswith("-"):
            continue
        parts = line.split()
        if parts and parts[0] not in ("id", "Team"):
            teams.append(parts[0])
    return teams


def discover_projects(team):
    cmd = ["vercel", "projects", "ls"] + (["--scope", team] if team else [])
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        return []
    projects = []
    for line in p.stdout.splitlines():
        s = line.strip()
        if not s or s.startswith(">") or s.startswith("Project Name") or s.startswith("Next page") or s.startswith("All pages") or s.startswith("vercel "):
            continue
        col = line.split("\t")[0].strip()
        if col:
            projects.append(col)
    return projects


def prompt_choice(label, options, default_val=None):
    print(f"\n{label}", file=sys.stderr)
    for idx, opt in enumerate(options, 1):
        mark = " (default)" if opt == default_val else ""
        print(f"  {idx}. {opt}{mark}", file=sys.stderr)
    while True:
        hint = f" [{default_val}]" if default_val else ""
        raw = input(f"Select number or enter value{hint}: ").strip()
        if not raw and default_val:
            return default_val
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        if raw:
            return raw


def cmd_init(args):
    yes, args = parse_flag(args, "--yes", has_value=False)
    team, args = parse_flag(args, "--team", has_value=True)
    project, args = parse_flag(args, "--project", has_value=True)
    agent, args = parse_flag(args, "--agent", has_value=True)
    tools_csv, args = parse_flag(args, "--tools", has_value=True)
    vcpus, args = parse_flag(args, "--vcpus", has_value=True)
    timeout, args = parse_flag(args, "--timeout", has_value=True)
    idle_min, args = parse_flag(args, "--idle-minutes", has_value=True)
    fx_channel, args = parse_flag(args, "--fx-channel", has_value=True)
    skill_repos, args = parse_multi_flag(args, "--skill-repo")
    warm_repos, args = parse_multi_flag(args, "--warm-repo")
    skip_base, args = parse_flag(args, "--skip-base", has_value=False)
    if args:
        die(f"unknown flags for init: {' '.join(args)}", 2)

    if not shutil.which("vercel"):
        die("vercel CLI not found. Install it first (e.g. npm i -g vercel or brew install vercel-cli).")

    ok, who = vercel_logged_in()
    if not ok:
        if yes:
            die("vercel CLI is not signed in. Run: vercel login", 1)
        say("vercel CLI is not signed in; starting `vercel login`")
        subprocess.check_call(["vercel", "login"])
        ok, who = vercel_logged_in()
    say(f"signed in to Vercel as {who}")

    old = read_config()
    if not team:
        teams = discover_teams()
        if yes:
            team = old.get("team") or (teams[0] if teams else die("pass --team <team>", 2))
        elif teams:
            team = prompt_choice("Choose your Vercel team/scope for sandboxes:", teams, old.get("team") or teams[0])
        else:
            team = input(f"Vercel team/scope [{old.get('team', '')}]: ").strip() or old.get("team", "")
    if not team:
        die("a Vercel team/scope is required", 2)

    if not project:
        projects = discover_projects(team)
        default_proj = old.get("project") or ("vercel-sandbox-default-project" if "vercel-sandbox-default-project" in projects else (projects[0] if projects else None))
        if yes:
            project = default_proj or die("pass --project <project>", 2)
        elif projects:
            project = prompt_choice(f"Choose a Vercel project under '{team}':", projects[:20], default_proj)
        else:
            project = input(f"Vercel project [{default_proj or ''}]: ").strip() or (default_proj or "")
    if not project:
        die("a Vercel project is required", 2)

    shims = all_shims()
    if not agent:
        default_agent = old.get("default_agent", "fx")
        agent = default_agent if yes else prompt_choice(
            "Choose your default coding agent:",
            sorted(shims.keys()),
            default_agent,
        )
    if agent not in shims:
        die(f"unknown agent '{agent}'", 2)

    if tools_csv is not None:
        tools = [t.strip() for t in tools_csv.split(",") if t.strip()]
    elif yes:
        tools = old.get("tools", ["gh", "node"])
    else:
        default_tools = ",".join(old.get("tools", ["gh", "node"]))
        raw_tools = input(f"Optional toolchains to preinstall (comma-separated from: gh,node,bun,zig,python) [{default_tools}]: ").strip()
        tools = [t.strip() for t in (raw_tools or default_tools).split(",") if t.strip()]

    cfg = {
        "team": team,
        "project": project,
        "default_agent": agent,
        "agents": sorted(set([agent, *(old.get("agents") or [])])),
        "vcpus": vcpus or old.get("vcpus", "8"),
        "timeout": timeout or old.get("timeout", "6h"),
        "idle_minutes": int(idle_min) if idle_min is not None else old.get("idle_minutes", 30),
        "tools": tools,
        "fx_channel": fx_channel or old.get("fx_channel", "stable"),
        "skill_repos": skill_repos or old.get("skill_repos", []),
        "warm_repos": warm_repos or old.get("warm_repos", []),
        "mcp_servers": old.get("mcp_servers", None),
    }
    write_json(CONFIG_FILE, cfg)
    say(f"saved config to {CONFIG_FILE}")

    if not skip_base:
        cmd_base([])


def build_base_setup_script(cfg, agents_to_install):
    tools = set(cfg.get("tools") or [])
    shims = all_shims(cfg)
    selected = [shims[a] for a in agents_to_install if a in shims]
    git_name, git_email = local_git_identity()

    lines = [
        "set -euo pipefail",
        'export PATH="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.opencode/bin:/usr/local/bin:$PATH"',
        "log() { printf '[fxs-base] %s\\n' \"$*\"; }",
        'mkdir -p -m 700 "$HOME/.fx" "$HOME/.fx/themes" "$HOME/.fx/skills" "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.config/opencode/skills"',
        'if [ -f /tmp/fxs-skills.tgz ]; then tar -xzf /tmp/fxs-skills.tgz -C "$HOME" && rm -f /tmp/fxs-skills.tgz; fi',
        'if [ -f /tmp/fxs-profile.tgz ]; then tar -xzf /tmp/fxs-profile.tgz -C "$HOME" && rm -f /tmp/fxs-profile.tgz; fi',
        'if [ -f /tmp/fxs-creds.tgz ]; then (umask 077 && tar -xzf /tmp/fxs-creds.tgz -C "$HOME") && rm -f /tmp/fxs-creds.tgz; fi',
        "missing=()",
        "for cmd in git rg jq curl unzip dtach; do command -v \"$cmd\" >/dev/null 2>&1 || missing+=(\"$cmd\"); done",
        "command -v ssh-keygen >/dev/null 2>&1 || missing+=(openssh-client)",
        "command -v xz >/dev/null 2>&1 || missing+=(xz-utils)",
    ]
    if "gh" in tools:
        lines.append("command -v gh >/dev/null 2>&1 || missing+=(gh)")
    if "zsh" in tools:
        lines.append("command -v zsh >/dev/null 2>&1 || missing+=(zsh)")
    if "fish" in tools:
        lines.append("command -v fish >/dev/null 2>&1 || missing+=(fish)")
    lines.extend([
        'if [ "${#missing[@]}" -gt 0 ]; then',
        "  pkgs=(); for m in \"${missing[@]}\"; do [ \"$m\" = \"rg\" ] && pkgs+=(ripgrep) || pkgs+=(\"$m\"); done",
        '  log "installing packages: ${pkgs[*]}"',
        "  sudo DEBIAN_FRONTEND=noninteractive apt-get update -qq",
        '  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}" >/dev/null',
        "fi",
        'if [ -f /etc/zsh/zshenv ] && ! grep -qs skip_global_compinit /etc/zsh/zshenv; then echo "skip_global_compinit=1" | sudo tee -a /etc/zsh/zshenv >/dev/null; fi',
    ])

    if "zig" in tools:
        lines.append(f'''
if [ "$(zig version 2>/dev/null || true)" != "{ZIG_VERSION}" ]; then
  arch="$(uname -m)"
  read -r url sha < <(curl -fsSL https://ziglang.org/download/index.json | python3 -c '
import json, sys
d = json.load(sys.stdin)[sys.argv[1]][sys.argv[2] + "-linux"]
print(d["tarball"], d["shasum"])' "{ZIG_VERSION}" "$arch")
  log "installing zig {ZIG_VERSION}"
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/zig.tar.xz" "$url"
  echo "$sha  $tmp/zig.tar.xz" | sha256sum -c --quiet -
  sudo mkdir -p /opt/zig
  sudo tar -xJf "$tmp/zig.tar.xz" -C /opt/zig
  dir="$(basename "$url" .tar.xz)"
  sudo ln -sfn "/opt/zig/$dir/zig" /usr/local/bin/zig
  rm -rf "$tmp"
fi
'''.strip())

    if "bun" in tools:
        lines.append(f'''
if [ "$(bun --version 2>/dev/null || true)" != "{BUN_VERSION}" ]; then
  log "installing bun {BUN_VERSION}"
  curl -fsSL https://bun.sh/install | bash -s "bun-v{BUN_VERSION}" >/dev/null 2>&1
  sudo ln -sfn "$HOME/.bun/bin/bun" /usr/local/bin/bun
fi
'''.strip())

    for shim in selected:
        lines.append(f'log "installing agent: {shim.name}"')
        lines.append(shim.install_cmd)

    lines.append(r'''
if [ ! -x /usr/local/bin/tailscaled ]; then
  arch="$(uname -m)"
  ts_arch="amd64"; [ "$arch" = "aarch64" ] && ts_arch="arm64"
  pkg="$(curl -fsSL "https://pkgs.tailscale.com/stable/?mode=json" | python3 -c "import json,sys; print(json.load(sys.stdin)['Tarballs'][sys.argv[1]])" "$ts_arch")"
  log "installing $pkg"
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/ts.tgz" "https://pkgs.tailscale.com/stable/$pkg"
