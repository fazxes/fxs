def cmd_fit(args):
    """Send SIGWINCH + 1-col bounce to non-SSH dtach/agent PTYs so sandboxes snap back to local width."""
    cfg = require_config()
    if args:
        sb, _sid, _ag = resolve_sandbox_and_session(" ".join(args), cfg=cfg)
        targets = [sb]
    else:
        targets = [n for n, _st, _line in list_sandboxes(cfg, all_states=False) if n.startswith("fxs-")]
    if not targets:
        say("no running sandboxes to fit")
        return
    mac_ip = get_self_tailscale_ip() or ""
    fit_script = r'''
mac_ip=__MAC_IP__
other_ssh_pids="$(ps -eo pid=,args= | awk -v mip="$mac_ip" '$0 ~ /tailscaled be-child ssh/ && (mip == "" || index($0, "--remote-ip=" mip) == 0) {print $1}' | tr '\n' ' ' || true)"
ps -eo pid=,ppid=,tty=,args= | while read -r pid ppid tty rest; do
  case "$tty" in pts/*) ;; *) continue ;; esac
  case "$rest" in *"dtach"*"/tmp/fxs-agent.sock"*) ;; *) continue ;; esac
  case " $other_ssh_pids " in *" $ppid "*) continue ;; esac
  kill -WINCH "$pid" 2>/dev/null && echo "FIT:$pid:$tty" || true
done
mac_tty="$(ps -eo pid=,ppid=,tty=,args= | awk -v sp=" $other_ssh_pids " '$3 ~ /^pts\// && $0 ~ /dtach .*\/tmp\/fxs-agent\.sock/ && index(sp, " " $2 " ") == 0 {print $3; exit}')"
master_pid="$(ps -eo pid=,tty=,args= | awk '$2 == "?" && $0 ~ /dtach .*\/tmp\/fxs-agent\.sock/ {print $1; exit}')"
agent_row="$( [ -n "$master_pid" ] && ps -eo pid=,ppid=,tty= | awk -v mp="$master_pid" '$2 == mp && $3 ~ /^pts\// {print $1, $3; exit}' || true )"
if [ -n "$mac_tty" ] && [ -n "$agent_row" ]; then
  ap="${agent_row%% *}"
  at="${agent_row#* }"
  read -r rows cols < <(stty -F "/dev/$mac_tty" size 2>/dev/null || echo "")
  if [ -n "${rows:-}" ] && [ -n "${cols:-}" ] && [ "$cols" -gt 20 ]; then
    stty -F "/dev/$at" rows "$rows" cols "$((cols - 1))" 2>/dev/null || true
    kill -WINCH "$ap" 2>/dev/null || true
    sleep 0.1
    stty -F "/dev/$at" rows "$rows" cols "$cols" 2>/dev/null || true
    kill -WINCH "$ap" 2>/dev/null || true
  fi
fi
'''.replace("__MAC_IP__", shlex.quote(mac_ip))
    for sb in targets:
        p = remote_exec(cfg, sb, fit_script, check=False, capture=True)
        fitted = [l for l in p.stdout.splitlines() if l.startswith("FIT:")]
        if fitted:
            say(f"fitted {sb} back to local width ({', '.join(fitted)})")


def cmd_termius_csv(args):
    cfg = require_config()
    out_arg, args = parse_flag(args, "--out", has_value=True)
    use_mosh, args = parse_flag(args, "--mosh", has_value=False)
    proto = "mosh" if use_mosh else "ssh"
    count = 100
    if args:
        if len(args) != 1 or not args[0].isdigit() or int(args[0]) < 1:
            die("usage: fxs termius-csv [COUNT] [--mosh] [--out FILE]", 2)
        count = int(args[0])
    suffix = get_tailnet_suffix()
    if not suffix:
        die("could not detect Tailscale MagicDNSSuffix; ensure Tailscale is running locally")

    out_path = Path(os.path.expanduser(out_arg)).resolve() if out_arg else (CONFIG_DIR / f"termius-{count}.csv")
    out_path.parent.mkdir(parents=True, exist_ok=True)

    rows = []
    seen = set()
    for name, _st, _line in list_sandboxes(cfg, all_states=False):
        if name.startswith("fxs-"):
            m = re.fullmatch(r"fxs-(\d+)", name)
            if m and 1 <= int(m.group(1)) <= count:
                continue
            seen.add(name)
            rows.append(["fxs", name, "fxs", f"{name}.{suffix}", proto, "22", "ubuntu", ""])

    for i in range(1, count + 1):
        name = f"fxs-{i}"
        if name not in seen:
            rows.append(["fxs", name, "fxs", f"{name}.{suffix}", proto, "22", "ubuntu", ""])

    with open(out_path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["Groups", "Label", "Tags", "Hostname/IP", "Protocol", "Port", "Username", "Password"])
        w.writerows(rows)

    say(f"wrote {len(rows)} hosts (fxs-1..fxs-{count} + active) to {out_path}")
