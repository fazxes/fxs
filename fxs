def resolve_sandbox_and_session(target):
    data = read_sandboxes()
    if target in data:
        return target, data[target].get("session_id"), data[target].get("agent")
    for sb_name, rec in data.items():
        if rec.get("session_id") == target:
            return sb_name, target, rec.get("agent")
    for r in read_json(SESSIONS_INDEX, []):
        if r.get("id") == target and r.get("sandbox"):
            return r["sandbox"], target, r.get("agent")
    return target, None, None


def pick_sandbox_to_resume():
    data = read_sandboxes()
    rows = sorted(
        data.items(),
        key=lambda kv: float(kv[1].get("last_active") or kv[1].get("stopped_at") or 0),
        reverse=True,
    )
    if not rows:
        die("no saved sandboxes found; pass a sandbox name: fxs resume <name>", 2)
    print("Recent sandboxes:", file=sys.stderr)
    for i, (n, r) in enumerate(rows[:15], 1):
        state = "running" if r.get("managed") else (r.get("stopped_reason") or "stopped")
        print(f"  {i}. {n}  [{r.get('agent','fx')}] [{state}]  {r.get('session_id') or '?'}  {r.get('title') or ''}", file=sys.stderr)
    try:
        ans = input("Pick number to resume [1]: ").strip()
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        sys.exit(130)
    idx = int(ans) - 1 if ans.isdigit() else (0 if ans == "" else -1)
    if not (0 <= idx < min(len(rows), 15)):
        die("invalid selection", 2)
    return rows[idx][0]


def cmd_resume(args):
    cfg = require_config()
    flags, agent_args = split_passthrough(args)
    sid_flag, flags = parse_flag(flags, "--id", has_value=True)
    agent_flag, flags = parse_flag(flags, "--agent", has_value=True)
    if not flags and not sid_flag:
        target = pick_sandbox_to_resume() if sys.stdin.isatty() else die("usage: fxs resume <sandbox|id>", 2)
    else:
        target = sid_flag or flags[0]
    name, resume_id, known_agent = resolve_sandbox_and_session(target)
    agent_name = agent_flag or known_agent or cfg.get("default_agent", "fx")
    if resume_id:
        say(f"resuming {name} ({agent_name} session {resume_id})")
    if TAILSCALE_KEY_FILE.exists() and not os.environ.get("FXS_NO_TAILSCALE"):
        start_sandbox_tailscale(cfg, name, interactive_if_no_key=False)
    run_agent_loop(cfg, name, agent_name, agent_args, continue_first=True, resume_id=resume_id)


def cmd_watchdog(args):
    sub = args[0] if args else "status"
    if sub == "__run":
        return run_watchdog_daemon()
    if sub == "status":
        cfg = read_config()
        idle_min = int(os.environ.get("FXS_IDLE_MINUTES", str(cfg.get("idle_minutes", 30))))
        pid = watchdog_running()
        data = read_sandboxes()
        managed = {k: v for k, v in data.items() if v.get("managed")}
        print(f"watchdog: {'running (pid ' + str(pid) + ')' if pid else 'stopped'}   idle_limit: {idle_min}m")
        if managed:
            now = time.time()
            for name, rec in managed.items():
                idle_m = (now - float(rec.get("last_active", now))) / 60
                print(f"  {name}  [{rec.get('agent','fx')}]  session={rec.get('session_id') or '?'}  idle={idle_m:.1f}m  {rec.get('title') or ''}")
        else:
            print("  no managed running sandboxes")
        return 0
    if sub == "stop":
        pid = watchdog_running()
        if not pid:
            say("watchdog is not running")
            return 0
        os.kill(pid, signal.SIGTERM)
        say(f"stopped watchdog (pid {pid})")
        return 0
    die("usage: fxs watchdog [status|stop]", 2)


def cmd_agents(args):
