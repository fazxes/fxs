]


def run_vc(cfg, sub, *args, check=True, capture=False):
    cmd = vc_args(cfg, sub, *args)
    if capture:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if check and p.returncode != 0:
            sys.stderr.write((p.stdout + p.stderr)[-3000:])
            die(f"vercel sandbox {sub} failed (exit {p.returncode})")
        return p
    rc = subprocess.call(cmd)
    if check and rc != 0:
        die(f"vercel sandbox {sub} failed (exit {rc})")
    return rc


IMAGE_PASTE_RE = re.compile(r"(/[^\r\n\"'<>\x1b]+?\.(?:png|jpe?g|webp|gif))", re.IGNORECASE)
ANSI_CSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")


def extract_local_image_paths(data_bytes):
    text = data_bytes.decode("utf-8", "ignore").replace("\\ ", " ")
    found = []
    for m in IMAGE_PASTE_RE.finditer(text):
        p = m.group(1)
        if os.path.isfile(p) and p not in found:
            found.append(p)
    return found


def sync_pasted_images(cfg, name, paths, uploaded_cache, ts_ip=None):
    to_send = []
    for p in paths:
        try:
            mt = os.path.getmtime(p)
        except OSError:
            continue
        if uploaded_cache.get(p) == mt:
            continue
        to_send.append((p, mt))
    if not to_send:
        return
    parents = sorted({os.path.dirname(p) for p, _ in to_send})
    mk = " && ".join(f"sudo mkdir -p {shlex.quote(d)} && sudo chown $(id -u):$(id -g) {shlex.quote(d)}" for d in parents)
    if ts_ip and shutil.which("ssh") and shutil.which("scp"):
        subprocess.run(["ssh", "-o", "BatchMode=yes", *SSH_BASE_OPTS, f"ubuntu@{ts_ip}", mk], stdin=subprocess.DEVNULL, capture_output=True)
        for p, mt in to_send:
            cp = subprocess.run(["scp", "-q", "-o", "BatchMode=yes", *SSH_BASE_OPTS, p, f"ubuntu@{ts_ip}:{p}"], stdin=subprocess.DEVNULL, capture_output=True)
            if cp.returncode == 0:
                uploaded_cache[p] = mt
        return
    subprocess.run(vc_args(cfg, "exec", name, "--", "bash", "-lc", mk), stdin=subprocess.DEVNULL, capture_output=True)
    for p, mt in to_send:
        cp = subprocess.run(vc_args(cfg, "copy", p, f"{name}:{p}"), stdin=subprocess.DEVNULL, capture_output=True)
        if cp.returncode == 0:
            uploaded_cache[p] = mt


def reset_local_terminal(saved_attrs=None):
    """Restore local TTY + Kitty/modifyOtherKeys/paste/theme/mouse modes if remote stream drops mid-TUI."""
    if saved_attrs is not None:
        with contextlib.suppress(Exception):
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, saved_attrs)
    if sys.stdout.isatty():
        with contextlib.suppress(OSError):
            os.write(
                sys.stdout.fileno(),
                b"\x1b[>4;0m\x1b[<u\x1b[<u\x1b[=0u"
                b"\x1b[?2004l\x1b[?2031l\x1b[?7h"
                b"\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l"
                b"\x1b[?1004l\x1b[?25h\x1b[0m",
            )


def run_interactive_with_image_sync(cfg, name, script):
    ts_ip = None
    if not os.environ.get("FXS_USE_VERCEL_EXEC") and shutil.which("ssh"):
        ts_ip = get_tailscale_peer_ip(name)
    if ts_ip:
        remote_cmd = f"TERM=xterm-256color COLORTERM=truecolor LANG=C.UTF-8 bash -lc {shlex.quote(script)}"
        cmd = ["ssh", "-t", *SSH_BASE_OPTS, f"ubuntu@{ts_ip}", remote_cmd]
    else:
        cmd = vc_args(cfg, "exec", "-i", *TERM_ENV, name, "--", "bash", "-lc", script)
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return subprocess.call(cmd)

    saved_attrs = None
    with contextlib.suppress(Exception):
        saved_attrs = termios.tcgetattr(sys.stdin.fileno())
    stop_event = threading.Event()
    uploaded = {}
    pulled_traces = set()
    tmpdir = os.environ.get("TMPDIR") or "/tmp"
    start_ts = time.time() - 5.0

    def watch_clipboard_and_traces():
        last_trace_check = 0.0
        while not stop_event.is_set():
            try:
                for fn in os.listdir(tmpdir):
                    if fn.lower().endswith((".png", ".jpg", ".jpeg", ".webp", ".gif")):
                        full = os.path.join(tmpdir, fn)
                        try:
                            mt = os.path.getmtime(full)
                        except OSError:
                            continue
                        if mt >= start_ts and uploaded.get(full) != mt:
                            sync_pasted_images(cfg, name, [full], uploaded, ts_ip=ts_ip)
            except OSError:
                pass

            now = time.monotonic()
            if now - last_trace_check >= 3.0:
                last_trace_check = now
                if ts_ip and shutil.which("ssh") and shutil.which("scp"):
                    p = subprocess.run(
                        ["ssh", "-o", "BatchMode=yes", *SSH_BASE_OPTS, f"ubuntu@{ts_ip}", "ls -1 /tmp/fx-trace-*.jsonl 2>/dev/null || true"],
                        stdin=subprocess.DEVNULL, capture_output=True, text=True,
                    )
                else:
                    p = subprocess.run(
                        vc_args(cfg, "exec", name, "--", "bash", "-lc", "ls -1 /tmp/fx-trace-*.jsonl 2>/dev/null || true"),
                        stdin=subprocess.DEVNULL, capture_output=True, text=True,
                    )
                if p.returncode == 0:
                    for tp in p.stdout.splitlines():
                        tp = tp.strip()
                        if tp and tp not in pulled_traces:
                            if ts_ip and shutil.which("scp"):
                                cp = subprocess.run(
                                    ["scp", "-q", "-o", "BatchMode=yes", *SSH_BASE_OPTS, f"ubuntu@{ts_ip}:{tp}", tp],
                                    stdin=subprocess.DEVNULL, capture_output=True,
                                )
                            else:
                                cp = subprocess.run(vc_args(cfg, "copy", f"{name}:{tp}", tp), stdin=subprocess.DEVNULL, capture_output=True)
                            if cp.returncode == 0:
                                pulled_traces.add(tp)
            stop_event.wait(0.35)

    t = threading.Thread(target=watch_clipboard_and_traces, daemon=True)
    t.start()
    try:
        return subprocess.call(cmd)
    finally:
        stop_event.set()
        t.join(timeout=1.0)
        reset_local_terminal(saved_attrs)


def remote_exec(cfg, name, script, interactive=False, env=None, workdir=None, check=True, capture=False):
    args = []
    if interactive:
        args.append("-i")
    if workdir:
        args.extend(["-w", workdir])
    for e in (env or []):
        args.extend(["-e", e] if "=" in e and not e.startswith("-") else [e])
    if interactive:
        args.extend(TERM_ENV)
    args.extend([name, "--", "bash", "-lc", script])
    cmd = vc_args(cfg, "exec", *args)
    if capture:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if check and p.returncode != 0:
            sys.stderr.write((p.stdout + p.stderr)[-3000:])
            die(f"sandbox command failed (exit {p.returncode})")
        return p
    rc = subprocess.call(cmd)
    if check and rc != 0:
        die(f"sandbox command failed (exit {rc})")
    return rc


def parse_flag(args, name, has_value=False):
    out = []
    val = None
    found = False
    i = 0
    while i < len(args):
        if args[i] == "--":
            out.extend(args[i:])
            break
        if args[i] == name:
            found = True
            if has_value:
                if i + 1 >= len(args):
                    die(f"{name} requires a value", 2)
                val = args[i + 1]
                i += 2
                continue
            i += 1
            continue
        out.append(args[i])
        i += 1
    return (val if has_value else found), out


def parse_multi_flag(args, name):
    out = []
    vals = []
    i = 0
    while i < len(args):
        if args[i] == "--":
            out.extend(args[i:])
            break
        if args[i] == name:
            if i + 1 >= len(args):
                die(f"{name} requires a value", 2)
            vals.append(args[i + 1])
            i += 2
            continue
        out.append(args[i])
        i += 1
    return vals, out


def split_passthrough(args):
    if "--" in args:
        idx = args.index("--")
        return args[:idx], args[idx + 1:]
    return args, []


def sanitize_fx_settings(raw_text):
    data = json.loads(raw_text)
    data.pop("workspaces", None)
    data["sandbox"] = "none"
    return json.dumps(data, indent=2) + "\n"


def filter_mcp_json(raw_text, allowed_servers=None):
    mcp_data = json.loads(raw_text)
    servers = mcp_data.get("mcp") or {}
    allow = set(allowed_servers) if allowed_servers is not None else None
    http_only = {
        k: v for k, v in servers.items()
        if isinstance(v, dict)
        and v.get("type") == "http"
        and (allow is None or k in allow)
    }
    if not http_only:
        return None
    return json.dumps({"mcp": http_only}, indent=2) + "\n"


def add_skills_tree(tar, src_root, arc_prefix):
    if not src_root.is_dir():
        return
    for entry in sorted(src_root.iterdir()):
        if entry.name in SKILL_SKIP:
            continue
        resolved_dir = entry.resolve() if entry.is_symlink() else entry
        if not resolved_dir.is_dir() or not (resolved_dir / "SKILL.md").is_file():
            continue
        for dirpath, dirnames, filenames in os.walk(resolved_dir, followlinks=True):
            dirnames[:] = sorted(d for d in dirnames if d not in SKILL_SKIP)
            for fn in sorted(filenames):
                if fn in SKILL_SKIP:
                    continue
                fp = Path(dirpath) / fn
                if not fp.is_file():
                    continue
                rel = fp.relative_to(resolved_dir)
                arc = f"{arc_prefix}/{entry.name}/{rel.as_posix()}"
                raw = fp.read_bytes()
                ti = tarfile.TarInfo(arc)
                ti.size = len(raw)
                ti.mode = fp.stat().st_mode & 0o755 | 0o644
                tar.addfile(ti, io.BytesIO(raw))


def build_profile_bundle(tmp_dir, cfg):
    """Package user agent configs, themes, instruction files, and HTTP MCP config."""
    tgz = Path(tmp_dir) / "fxs-profile.tgz"
    h = hashlib.sha256()

    def add_bytes(arc, raw_bytes, mode=0o644):
        h.update(arc.encode() + b"\0" + raw_bytes)
        ti = tarfile.TarInfo(arc)
        ti.size = len(raw_bytes)
        ti.mode = mode
        tar.addfile(ti, io.BytesIO(raw_bytes))

    with tarfile.open(tgz, "w:gz") as tar:
        fx_dir = HOME / ".fx"
        if (fx_dir / "settings.json").is_file():
            try:
                add_bytes(".fx/settings.json", sanitize_fx_settings((fx_dir / "settings.json").read_text()).encode(), 0o600)
            except Exception:
                pass
        if (fx_dir / "themes").is_dir():
            for p in sorted((fx_dir / "themes").iterdir()):
                if p.is_file():
                    add_bytes(f".fx/themes/{p.name}", p.read_bytes(), 0o644)
        if (fx_dir / "AGENTS.md").is_file():
            add_bytes(".fx/AGENTS.md", (fx_dir / "AGENTS.md").read_bytes(), 0o644)
        mcp_servers = cfg.get("mcp_servers")
        if mcp_servers != [] and (fx_dir / "mcp.json").is_file():
            try:
                filtered = filter_mcp_json((fx_dir / "mcp.json").read_text(), mcp_servers)
                if filtered:
                    add_bytes(".fx/mcp.json", filtered.encode(), 0o600)
            except Exception:
                pass

        for src_rel in (".claude/settings.json", ".claude/CLAUDE.md", ".codex/config.toml", ".codex/AGENTS.md"):
            p = HOME / src_rel
            if p.is_file():
                add_bytes(src_rel, p.read_bytes(), 0o600 if src_rel.endswith(".json") else 0o644)

        opencode_cfg = HOME / ".config" / "opencode"
        if opencode_cfg.is_dir():
            for p in sorted(opencode_cfg.rglob("*")):
                if p.is_file() and not any(part in SKILL_SKIP for part in p.parts) and p.name != "skills":
                    if "skills" in p.relative_to(opencode_cfg).parts:
                        continue
                    add_bytes(p.relative_to(HOME).as_posix(), p.read_bytes(), 0o644)

    return tgz, h.hexdigest()[:16]


def build_skills_bundle(tmp_dir):
