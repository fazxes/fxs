@dataclass
class AgentShim:
    name: str
    description: str
    bin_path: str
    install_cmd: str
    auth_check_cmd: str
    auth_login_cmd: str
    skills_dir: str
    session_subdir: str
    supports_session_sync: bool = False
    extra_env: dict = field(default_factory=dict)
    resume_flag: str = "--resume"
    continue_flag: str = "--continue"
    subcommand_resume: bool = False

    def launch_command(self, args, resume_id=None, continue_last=False):
        extra = []
        if resume_id:
            if self.subcommand_resume:
                extra.extend(["resume", resume_id])
            else:
                extra.extend([self.resume_flag, resume_id])
        elif continue_last:
            if self.subcommand_resume:
                extra.extend(["resume", "--last"])
            else:
                extra.append(self.continue_flag)
        extra.extend(args)
        bin_expr = self.bin_path if self.bin_path.startswith("$HOME/") else shlex.quote(self.bin_path)
        return " ".join([bin_expr, *(shlex.quote(p) for p in extra)])


