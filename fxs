def extract_sandbox_paths(cfg, name, selected, dest):
    dest = Path(dest).resolve()
    dest.mkdir(parents=True, exist_ok=True)
    quoted = " ".join(shlex.quote(s) for s in selected)
    tar_script = (
        f"cd ~ && tar --exclude=.zig-cache --exclude=node_modules --exclude=__pycache__ "
        f"--exclude=zig-out -czf /tmp/fxs-pull.tgz {quoted}"
    )
    remote_exec(cfg, name, tar_script, capture=True)
    with tempfile.TemporaryDirectory() as tmp:
        local_tgz = Path(tmp) / "fxs-pull.tgz"
        run_vc(cfg, "copy", f"{name}:/tmp/fxs-pull.tgz", str(local_tgz), capture=True)
        subprocess.run(vc_args(cfg, "exec", name, "--", "rm", "-f", "/tmp/fxs-pull.tgz"), capture_output=True)
        dest_real = os.path.realpath(dest)
        count = 0
        with tarfile.open(local_tgz, "r:gz") as tar:
            for m in tar.getmembers():
                target = os.path.realpath(os.path.join(dest_real, m.name))
                if not (target == dest_real or target.startswith(dest_real + os.sep)):
                    continue
                if m.isdir():
                    os.makedirs(target, exist_ok=True)
                elif m.isreg():
                    os.makedirs(os.path.dirname(target), exist_ok=True)
                    with tar.extractfile(m) as src, open(target, "wb") as out:
                        shutil.copyfileobj(src, out)
                    os.chmod(target, m.mode & 0o755 | 0o600)
                    count += 1
        say(f"copied {count} file(s) to {dest}")
        return count


def prompt_keep_files(cfg, name):
    items = list_sandbox_files(cfg, name)
    if not items:
        return
    print(file=sys.stderr)
    say(f"other files in {name}:")
    for idx, item in enumerate(items, 1):
        extra = f" ({item['note']}, {fmt_bytes(item['size'])})" if item.get("note") else f" ({fmt_bytes(item['size'])})"
        print(f"  {idx}. {item['path']}{extra}", file=sys.stderr)

    try:
        choice = input("Keep files locally? [a]ll, [p]ick numbers (e.g. 1,3), [n]one (default: n): ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        return
    if not choice or choice in ("n", "no", "none"):
        return

    selected = []
    if choice in ("a", "all"):
        selected = [it["path"] for it in items]
    else:
        raw = choice
        if choice in ("p", "pick"):
            try:
                raw = input("Enter numbers (comma or space separated): ").strip()
            except (EOFError, KeyboardInterrupt):
                print(file=sys.stderr)
                return
        for tok in re.split(r"[\s,]+", raw):
            if tok.isdigit() and 1 <= int(tok) <= len(items):
                selected.append(items[int(tok) - 1]["path"])
    selected = list(dict.fromkeys(selected))
    if not selected:
        say("no valid items selected; skipping")
        return

    default_dest = PULL_DEFAULT_ROOT / name
    try:
        dest_in = input(f"Copy to folder [{default_dest}]: ").strip()
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        return
    dest = Path(os.path.expanduser(dest_in)).resolve() if dest_in else default_dest
    extract_sandbox_paths(cfg, name, selected, dest)


