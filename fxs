def load_custom_shims():
    shims = {}
    if not CUSTOM_AGENTS_DIR.is_dir():
        return shims
    for p in sorted(CUSTOM_AGENTS_DIR.glob("*.json")):
        try:
            d = json.loads(p.read_text())
            name = d.get("name") or p.stem
            shims[name] = AgentShim(
                name=name,
                description=d.get("description", f"Custom shim ({name})"),
                bin_path=d["bin_path"],
                install_cmd=d.get("install_cmd", "true"),
                auth_check_cmd=d.get("auth_check_cmd", "true"),
                auth_login_cmd=d.get("auth_login_cmd", "true"),
                skills_dir=d.get("skills_dir", ".agents/skills"),
                session_subdir=d.get("session_subdir", ""),
                supports_session_sync=bool(d.get("supports_session_sync", False)),
                extra_env=d.get("extra_env") or {},
                resume_flag=d.get("resume_flag", "--resume"),
                continue_flag=d.get("continue_flag", "--continue"),
                subcommand_resume=bool(d.get("subcommand_resume", False)),
            )
        except Exception as e:
            say(f"warning: skipping invalid custom shim {p}: {e}")
    return shims


def all_shims(cfg=None):
    shims = builtin_shims(cfg)
    shims.update(load_custom_shims())
    return shims


def get_shim(name, cfg=None):
    shims = all_shims(cfg)
    if name not in shims:
        die(f"unknown agent '{name}'. Available: {', '.join(sorted(shims))}", 2)
    return shims[name]


def say(msg):
    print(f"fxs: {msg}", file=sys.stderr, flush=True)


def die(msg, code=1):
    say(msg)
    sys.exit(code)


def read_json(path, default):
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(path)


@contextlib.contextmanager
def file_lock(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)


def read_config():
    return read_json(CONFIG_FILE, {})


def require_config():
    cfg = read_config()
    if cfg.get("team") and cfg.get("project"):
        return cfg
    if sys.stdin.isatty():
        say("no fxs config found yet; starting onboarding")
        cmd_init([])
        cfg = read_config()
        if cfg.get("team") and cfg.get("project"):
            return cfg
    die("fxs is not configured yet. Run: fxs init --team <team> --project <project>", 2)


def vc_args(cfg, sub, *args):
    cmd = ["vercel", "sandbox", sub]
    if cfg.get("team"):
        cmd.extend(["--scope", cfg["team"]])
    if cfg.get("project"):
        cmd.extend(["--project", cfg["project"]])
    cmd.extend(args)
    return cmd


def tailscale_cli_bin():
    mac_bin = "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
    if os.path.isfile(mac_bin) and os.access(mac_bin, os.X_OK):
        return mac_bin
    return shutil.which("tailscale")


def get_self_tailscale_ip():
    ts = tailscale_cli_bin()
    if not ts:
        return None
    p = subprocess.run([ts, "status", "--json"], stdin=subprocess.DEVNULL, capture_output=True, text=True)
    if p.returncode != 0:
        return None
    try:
        d = json.loads(p.stdout)
    except Exception:
        return None
    if d.get("BackendState") != "Running":
        return None
    ips = (d.get("Self") or {}).get("TailscaleIPs") or []
    return next((x for x in ips if "." in x), None)


def get_tailscale_peer_ip(name):
    ts = tailscale_cli_bin()
    if not ts:
        return None
    p = subprocess.run([ts, "status", "--json"], stdin=subprocess.DEVNULL, capture_output=True, text=True)
    if p.returncode != 0:
        return None
    try:
        d = json.loads(p.stdout)
    except Exception:
        return None
    if d.get("BackendState") != "Running":
        return None
    target = name.lower()
    for peer in (d.get("Peer") or {}).values():
        hn = (peer.get("HostName") or "").lower()
        if hn == target and peer.get("Online"):
            ips = peer.get("TailscaleIPs") or []
            ip4 = next((x for x in ips if "." in x), None)
            if ip4:
                return ip4
    return None


SSH_BASE_OPTS = [
    "-o", "StrictHostKeyChecking=no",
    "-o", "UserKnownHostsFile=/dev/null",
    "-o", "LogLevel=ERROR",
    "-o", "ServerAliveInterval=15",
    "-o", "ServerAliveCountMax=3",
    "-o", "TCPKeepAlive=yes",
