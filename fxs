def fmt_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def sync_sessions_back(cfg, name, agent_name="fx"):
    if agent_name != "fx":
        return []
    p = remote_exec(
        cfg, name,
        f"python3 -c {shlex.quote(REMOTE_PACK_FX_SESSIONS_PY)}",
        check=False, capture=True,
    )
    if p.returncode != 0:
        return []
    try:
        info = json.loads(p.stdout.strip().splitlines()[-1])
    except Exception:
        return []
    if info.get("count", 0) == 0:
        subprocess.run(vc_args(cfg, "exec", name, "--", "rm", "-f", "/tmp/fxs-sessions.tgz"), capture_output=True)
        return []

    local_sessions_dir = Path(os.environ.get("FX_HOME", str(HOME / ".fx"))) / "sessions" / "v2"
    local_sessions_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        local_tgz = Path(tmp) / "fxs-sessions.tgz"
        cp = subprocess.run(vc_args(cfg, "copy", f"{name}:/tmp/fxs-sessions.tgz", str(local_tgz)), capture_output=True, text=True)
        subprocess.run(vc_args(cfg, "exec", name, "--", "rm", "-f", "/tmp/fxs-sessions.tgz"), capture_output=True)
        if cp.returncode != 0 or not local_tgz.exists():
            return []
        root_real = os.path.realpath(local_sessions_dir)
        with tarfile.open(local_tgz, "r:gz") as tar:
            for m in tar.getmembers():
                if not m.isreg() or not SESSION_MEMBER_RE.fullmatch(m.name):
                    continue
                target = os.path.realpath(os.path.join(root_real, m.name))
                if not target.startswith(root_real + os.sep):
                    continue
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with tar.extractfile(m) as src, open(target, "wb") as out:
                    shutil.copyfileobj(src, out)
                os.chmod(target, 0o600)

    roots = info.get("roots", [])
    if roots:
        saved = read_json(SESSIONS_INDEX, [])
        by_id = {r["id"]: r for r in saved if isinstance(r, dict) and "id" in r}
        now = time.time()
        for r in roots:
            by_id[r["id"]] = {
                "id": r["id"],
                "title": r["title"],
                "turns": r["turns"],
                "sandbox": name,
                "agent": agent_name,
                "saved_at": now,
            }
        merged = sorted(by_id.values(), key=lambda r: r.get("saved_at", 0), reverse=True)[:200]
        write_json(SESSIONS_INDEX, merged)
        for r in roots:
            say(f"saved session {r['id']} ({r['title']}, {r['turns']} turns) -> resume locally: fx -r {r['id']}")
    return roots


