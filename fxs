def extract_sandbox_paths(cfg, name, selected, dest):
    dest = Path(dest).resolve()
    dest.mkdir(parents=True, exist_ok=True)
    quoted = " ".join(shlex.quote(s) for s in selected)
    tar_script = (
        f"cd ~ && tar --exclude=.zig-cache --exclude=node_modules --exclude=__pycache__ "
        f"--exclude=zig-out -czf /tmp/fxs-pull.tgz {quoted}"
    )
    remote_exec(cfg, name, tar_script, capture=True)
    with tempfile.TemporaryDirectory() as tmp:
        local_tgz = Path(tmp) / "fxs-pull.tgz"
        run_vc(cfg, "copy", f"{name}:/tmp/fxs-pull.tgz", str(local_tgz), capture=True)
        subprocess.run(vc_args(cfg, "exec", name, "--", "rm", "-f", "/tmp/fxs-pull.tgz"), capture_output=True)
        dest_real = os.path.realpath(dest)
        count = 0
        with tarfile.open(local_tgz, "r:gz") as tar:
            for m in tar.getmembers():
                target = os.path.realpath(os.path.join(dest_real, m.name))
                if not (target == dest_real or target.startswith(dest_real + os.sep)):
                    continue
                if m.isdir():
                    os.makedirs(target, exist_ok=True)
                elif m.isreg():
                    os.makedirs(os.path.dirname(target), exist_ok=True)
                    with tar.extractfile(m) as src, open(target, "wb") as out:
                        shutil.copyfileobj(src, out)
                    os.chmod(target, m.mode & 0o755 | 0o600)
                    count += 1
        say(f"copied {count} file(s) to {dest}")
        return count


