items = files if len(files) <= 30 else top_entries
print(json.dumps({"items": items, "grouped": len(files) > 30}))
'''

REMOTE_PROBE_ACTIVITY_PY = r'''
import glob, json, os, subprocess, sys

agent = sys.argv[1] if len(sys.argv) > 1 else "fx"
working = False
sid = None
title = None
max_mtime = 0.0

if agent == "fx":
    fx_bin = os.path.expanduser("~/.local/bin/fx")
    p = subprocess.run([fx_bin, "sessions", "--live", "--all", "--json"], capture_output=True, text=True)
    sessions = []
    try:
        sessions = json.loads(p.stdout).get("sessions", [])
    except Exception:
        sessions = []

    def any_working(nodes):
        for n in nodes:
            if n.get("state") == "working":
                return True
            if any_working(n.get("agents") or []):
                return True
        return False

    working = any_working(sessions)
    sid = sessions[0].get("id") if sessions else None
    title = sessions[0].get("title") if sessions else None
    globs = [os.path.expanduser("~/.fx/sessions/v2/*/log.jsonl")]
    proc_pat = "/.local/bin/fx"
elif agent == "claude":
    globs = [os.path.expanduser("~/.claude/projects/*/*.jsonl")]
    proc_pat = "claude"
elif agent == "codex":
    globs = [os.path.expanduser("~/.codex/sessions/**/*.jsonl")]
    proc_pat = "codex"
else:
    globs = [os.path.expanduser("~/.local/share/opencode/**/*")]
    proc_pat = agent

pg = subprocess.run(["pgrep", "-f", proc_pat], capture_output=True, text=True)
pids = [x.strip() for x in pg.stdout.splitlines() if x.strip().isdigit()]
has_children = False
for pid in pids:
    ch = subprocess.run(["pgrep", "-P", pid], capture_output=True, text=True)
    if ch.stdout.strip():
        has_children = True
        break

for g in globs:
    for lp in glob.glob(g, recursive=True):
        try:
            max_mtime = max(max_mtime, os.path.getmtime(lp))
        except OSError:
            pass

print(json.dumps({
    "agent_alive": len(pids) > 0,
    "working": working or has_children,
    "session_id": sid,
    "title": title,
    "last_log_mtime": max_mtime,
    "pids": pids,
}))
