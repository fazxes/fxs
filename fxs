def _merged_sandbox_catalog(cfg, include_live=True):
    """Merge sandboxes.json + sessions.json + live Vercel sandboxes with latest titles."""
    data = read_sandboxes()
    live_map = {}
    if include_live and cfg:
        for n, st, line in list_sandboxes(cfg, all_states=True):
            if n.startswith("fxs-") or n in data:
                live_map[n] = (st, line)

    rows = {}
    for n, rec in data.items():
        r = dict(rec)
        if n in live_map:
            r["live_status"] = live_map[n][0]
            r["live_line"] = live_map[n][1]
        rows[n] = r

    for n, (st, line) in live_map.items():
        if n not in rows:
            rows[n] = {"live_status": st, "live_line": line}

    for item in read_json(SESSIONS_INDEX, []):
        sb = item.get("sandbox")
        if sb and sb in rows:
            rows[sb].setdefault("session_id", item.get("id"))
            rows[sb].setdefault("title", item.get("title"))
            rows[sb].setdefault("agent", item.get("agent"))

    def sort_key(kv):
        n, r = kv
        is_running = 1 if (r.get("live_status") == "running" or r.get("managed")) else 0
        ts = float(r.get("last_active") or r.get("stopped_at") or 0)
        return (is_running, ts, n)

    return sorted(rows.items(), key=sort_key, reverse=True)


def _format_row(idx, n, r):
    state = r.get("live_status") or ("running" if r.get("managed") else (r.get("stopped_reason") or "stopped"))
    agent = r.get("agent") or "fx"
    sid = r.get("session_id") or "-"
    alias = f" ({r['alias']})" if r.get("alias") else ""
    title = r.get("title") or "(untitled)"
    return f"  {idx:2d}. {n:<12} [{agent}] [{state:<7}]  {sid:<13} {title}{alias}"


def resolve_sandbox_and_session(target, cfg=None, include_live=True):
    rows = _merged_sandbox_catalog(cfg, include_live=include_live and cfg is not None)
    by_name = dict(rows)

    if target in by_name:
        r = by_name[target]
        return target, r.get("session_id"), r.get("agent")

    if target.isdigit() and f"fxs-{target}" in by_name:
        sb = f"fxs-{target}"
        r = by_name[sb]
        return sb, r.get("session_id"), r.get("agent")

    for sb_name, rec in rows:
        if rec.get("session_id") == target:
            return sb_name, target, rec.get("agent")
    for r in read_json(SESSIONS_INDEX, []):
        if r.get("id") == target and r.get("sandbox"):
            return r["sandbox"], target, r.get("agent")

    q = target.lower()
    for sb_name, rec in rows:
        if (rec.get("alias") or "").lower() == q:
            return sb_name, rec.get("session_id"), rec.get("agent")

    matches = [
        (n, r) for n, r in rows
        if q in n.lower()
        or q in (r.get("alias") or "").lower()
        or q in (r.get("title") or "").lower()
    ]
    if len(matches) == 1:
        n, r = matches[0]
        return n, r.get("session_id"), r.get("agent")
    if len(matches) > 1:
        if sys.stdin.isatty():
            n = pick_sandbox_to_resume(cfg, matches, header=f"Multiple sandboxes match '{target}':")
            r = by_name[n]
            return n, r.get("session_id"), r.get("agent")
        listing = "\n".join(_format_row(i, n, r) for i, (n, r) in enumerate(matches, 1))
        die(f"multiple sandboxes match '{target}':\n{listing}", 2)

    if cfg and sandbox_exists(cfg, target):
        return target, None, None

    if not cfg:
        return target, None, None
    listing = "\n".join(_format_row(i, n, r) for i, (n, r) in enumerate(rows[:20], 1))
    die(f"no sandbox matched '{target}'. Known sandboxes:\n{listing}" if listing else f"no sandbox matched '{target}'", 2)


def pick_sandbox_to_resume(cfg=None, rows=None, header="Sandboxes:"):
    if rows is None:
        rows = _merged_sandbox_catalog(cfg, include_live=cfg is not None)
    if not rows:
        die("no saved sandboxes found; pass a sandbox name: fxs resume <name>", 2)
    print(header, file=sys.stderr)
    for i, (n, r) in enumerate(rows, 1):
        print(_format_row(i, n, r), file=sys.stderr)
    try:
        ans = input("Pick number or type part of title/name [1]: ").strip()
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        sys.exit(130)
    if ans == "":
        return rows[0][0]
    if ans.isdigit():
        idx = int(ans) - 1
        if 0 <= idx < len(rows):
            return rows[idx][0]
        die("invalid selection", 2)
    q = ans.lower()
    matches = [
        (n, r) for n, r in rows
        if q in n.lower() or q in (r.get("alias") or "").lower() or q in (r.get("title") or "").lower()
    ]
    if len(matches) == 1:
        return matches[0][0]
    if len(matches) > 1:
        return pick_sandbox_to_resume(cfg, matches, header=f"Matches for '{ans}':")
    die(f"no sandbox matched '{ans}'", 2)


