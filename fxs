REMOTE_LIST_FILES_PY = r'''
import json, os, subprocess

home = os.path.expanduser("~")
skip_top = {"workspaces"}
skip_walk = {
    ".git", "node_modules", ".zig-cache", "zig-out", "__pycache__",
    ".venv", "venv", ".next", ".turbo", "target", ".DS_Store",
}

files = []
top_entries = []

def dir_size(path):
    total = 0
    count = 0
    for dp, dns, fns in os.walk(path):
        dns[:] = [d for d in dns if d not in skip_walk]
        for fn in fns:
            if fn in skip_walk:
                continue
            fp = os.path.join(dp, fn)
            if not os.path.islink(fp):
                try:
                    total += os.path.getsize(fp)
                    count += 1
                except OSError:
                    pass
    return count, total

for name in sorted(os.listdir(home)):
    if name in skip_top or name.startswith("."):
        continue
    full = os.path.join(home, name)
    if os.path.islink(full):
        continue
    if os.path.isfile(full):
        sz = os.path.getsize(full)
        item = {"path": name, "size": sz, "kind": "file"}
        files.append(item)
        top_entries.append(item)
    elif os.path.isdir(full):
        cnt, sz = dir_size(full)
        note = ""
        if os.path.isdir(os.path.join(full, ".git")):
            gp = subprocess.run(["git", "-C", full, "status", "--porcelain"], capture_output=True, text=True)
            dirty = len(gp.stdout.splitlines())
            note = f"{cnt} files, {dirty} changed" if dirty else f"{cnt} files"
        else:
            note = f"{cnt} files"
        top_entries.append({"path": name, "size": sz, "kind": "dir", "note": note})
        for dp, dns, fns in os.walk(full):
            dns[:] = [d for d in dns if d not in skip_walk]
            for fn in sorted(fns):
                if fn in skip_walk:
                    continue
                fp = os.path.join(dp, fn)
                if not os.path.islink(fp):
                    rel = os.path.relpath(fp, home)
                    try:
                        files.append({"path": rel, "size": os.path.getsize(fp), "kind": "file"})
                    except OSError:
                        pass

items = files if len(files) <= 30 else top_entries
print(json.dumps({"items": items, "grouped": len(files) > 30}))
'''

