def list_sandboxes(cfg, all_states=True, name_prefix=None, max_pages=50):
    """Paginate `vercel sandbox ls` (50/page API cap) so 100+ sandboxes are never truncated."""
    rows = []
    seen = set()
    cursor = None
    for _ in range(max_pages):
        args = ["--limit", "50"]
        if all_states:
            args.append("--all")
        if name_prefix:
            args.extend(["--name-prefix", name_prefix])
        if cursor:
            args.extend(["--cursor", cursor])
        p = subprocess.run(vc_args(cfg, "ls", *args), capture_output=True, text=True)
        if p.returncode != 0:
            break
        text = p.stdout + "\n" + p.stderr
        for line in text.splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[1] in ("running", "stopped", "pending", "stopping", "failed"):
                name = parts[0]
                if name not in seen:
                    seen.add(name)
                    rows.append((name, parts[1], line))
        m = re.search(r"--cursor\s+(\S+)", text)
        if not m or m.group(1) == cursor:
            break
        cursor = m.group(1)
    return rows


def next_slot_name(cfg):
    used = set()
    for name, _status, _line in list_sandboxes(cfg, all_states=True, name_prefix="fxs-"):
        m = re.fullmatch(r"fxs-(\d+)", name)
        if m:
            used.add(int(m.group(1)))
    slot = 1
    while slot in used:
        slot += 1
    return f"fxs-{slot}"


def get_tailnet_suffix():
    ts = tailscale_cli_bin()
    if ts:
        p = subprocess.run([ts, "status", "--json"], stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if p.returncode == 0:
            try:
                suffix = (json.loads(p.stdout).get("MagicDNSSuffix") or "").strip(".")
                if suffix:
                    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
                    TAILNET_FILE.write_text(suffix + "\n")
                    return suffix
            except Exception:
                pass
    if TAILNET_FILE.exists():
        val = TAILNET_FILE.read_text().strip(".")
        if val:
            return val
    return ""


def sync_ssh_config(cfg):
    """Maintain ~/.ssh/fxs_config for active sandboxes and ensure ~/.ssh/config includes it."""
    suffix = get_tailnet_suffix()
    data = read_sandboxes()
    running = list_sandboxes(cfg, all_states=False)
    hosts = []
    seen = set()
    for name, _status, _line in running:
        rec = data.get(name, {})
        dns = (rec.get("tailscale_dns") or "").strip(".")
        if not dns and suffix and (name.startswith("fxs-") or rec.get("tailscale_ip")):
            dns = f"{name}.{suffix}"
        if dns and name not in seen:
            seen.add(name)
            hosts.append((name, dns))
    for name, rec in sorted(data.items()):
        if name in seen:
            continue
        dns = (rec.get("tailscale_dns") or "").strip(".")
        if dns and rec.get("managed"):
            seen.add(name)
            hosts.append((name, dns))

    ssh_dir = HOME / ".ssh"
    ssh_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    lines = ["# Auto-generated by fxs; do not edit by hand.\n"]
    for name, dns in hosts:
        lines.append(f"Host {name} {dns}\n")
        lines.append(f"    HostName {dns}\n")
        lines.append("    User ubuntu\n")
        lines.append("    StrictHostKeyChecking no\n")
        lines.append("    UserKnownHostsFile /dev/null\n\n")
    fd = os.open(SSH_FXS_CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.writelines(lines)

    cfg_path = ssh_dir / "config"
    inc = "Include fxs_config"
    if cfg_path.exists():
        cur = cfg_path.read_text()
        if cur and not cur.endswith("\n"):
            cur += "\n"
        if inc not in cur.splitlines():
            cfg_path.write_text(inc + "\n" + cur)
    else:
        fd = os.open(cfg_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(inc + "\n")
    return len(hosts)


def sandbox_exists(cfg, name):
    p = subprocess.run(vc_args(cfg, "ls", "--all", "--name-prefix", name), capture_output=True, text=True)
    if p.returncode != 0:
        return False
    return any(line.split()[:1] == [name] for line in p.stdout.splitlines())


def export_creds_from(cfg, src_sandbox, tmp_dir):
    if not src_sandbox or not sandbox_exists(cfg, src_sandbox):
        return None
    say(f"carrying over CLI logins from {src_sandbox}")
    p = subprocess.run(
        vc_args(
            cfg, "exec", src_sandbox, "--", "bash", "-lc",
            "cd ~ && files=(); "
            "for f in .fx/auth.json .claude/.credentials.json .claude.json .codex/auth.json "
            ".config/gh/hosts.yml .config/gh/config.yml; do "
            "  [ -f \"$f\" ] && files+=(\"$f\"); "
            "done; "
            "[ ${#files[@]} -gt 0 ] && tar -czf /tmp/fxs-creds.tgz \"${files[@]}\" && echo OK",
        ),
        capture_output=True, text=True,
    )
    if p.returncode != 0 or "OK" not in p.stdout:
        return None
    local_tgz = Path(tmp_dir) / "fxs-creds.tgz"
    cp = subprocess.run(
        vc_args(cfg, "copy", f"{src_sandbox}:/tmp/fxs-creds.tgz", str(local_tgz)),
        capture_output=True, text=True,
    )
    subprocess.run(vc_args(cfg, "exec", src_sandbox, "--", "rm", "-f", "/tmp/fxs-creds.tgz"), capture_output=True)
    return local_tgz if cp.returncode == 0 and local_tgz.exists() else None


def vercel_logged_in():
    p = subprocess.run(["vercel", "whoami"], capture_output=True, text=True)
    return p.returncode == 0, p.stdout.strip()


def parse_teams_output(text):
    clean = ANSI_CSI_RE.sub("", text)
    teams = []
    seen = set()
    skip_first = {"id", "team", "vercel", "-", "fetching", ">", "error:", "warn:", "warning:"}
    for raw in clean.splitlines():
        line = raw.strip()
        if not line or line.startswith(("-", ">", "Vercel CLI", "Fetching", "Tip:", "To ")):
            continue
        parts = line.split()
        if not parts:
            continue
        slug = parts[0]
        if slug.lower() in skip_first and len(parts) >= 2 and parts[1].lower() in ("team", "cli", "name"):
            continue
        if re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,62}", slug) and slug not in ("id",) and slug not in seen:
            seen.add(slug)
            teams.append(slug)
    return teams


def discover_teams():
    p = subprocess.run(["vercel", "teams", "ls"], capture_output=True, text=True)
    if p.returncode != 0:
        return []
    return parse_teams_output(p.stdout + "\n" + p.stderr)


