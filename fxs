log "warming caches for {repo}"
wdir="$HOME/workspaces/{rname}"
mkdir -p "$HOME/workspaces"
if [ ! -d "$wdir/.git" ]; then
  GIT_TERMINAL_PROMPT=0 git clone --quiet {shlex.quote(url)} "$wdir" || true
fi
if [ -d "$wdir" ]; then
  (
    cd "$wdir"
    if [ -f build.zig ] && command -v zig >/dev/null 2>&1; then
      zig build || true
      if [ -f build.zig.zon ] && [ -d .zig-cache ]; then
        seeds="$HOME/.cache/fxs-zig-seed/{rname}"
        mkdir -p "$seeds" .zig-cache/tmp
        cp -a --reflink=auto .zig-cache "$seeds/cache"
        fp="$(grep -o -E '\\.fingerprint *= *0x[0-9a-fA-F]+' build.zig.zon | grep -o -E '0x[0-9a-fA-F]+' | tr 'A-F' 'a-f' || true)"
        cpu="$(cd /tmp && zig build-exe --show-builtin 2>/dev/null | grep -m1 -o 'cpu\\.[a-z0-9_]*' | cut -d. -f2 || true)"
        printf '{{"fingerprint":"%s","commit":"%s","cpus":["%s"]}}\\n' "$fp" "$(git rev-parse --short HEAD 2>/dev/null || echo head)" "$cpu" > "$seeds/meta.json"
      fi
    fi
    if [ -f package.json ]; then
      if command -v bun >/dev/null 2>&1; then bun install || true
      elif command -v npm >/dev/null 2>&1; then npm install || true; fi
    fi
  )
fi
'''.strip())

    return "\n".join(lines) + "\n"


def cmd_base(args):
    cfg = require_config()
    from_sb, args = parse_flag(args, "--from", has_value=True)
    no_warm, args = parse_flag(args, "--no-warm", has_value=False)
    agents_csv, args = parse_flag(args, "--agents", has_value=True)
    if args:
        die(f"unknown flags for base: {' '.join(args)}", 2)

    agents = [a.strip() for a in agents_csv.split(",") if a.strip()] if agents_csv else (cfg.get("agents") or [cfg.get("default_agent", "fx")])
    if no_warm:
        cfg = {**cfg, "warm_repos": []}

    with file_lock(CACHE_DIR / "base.lock"):
        old = read_json(BASE_FILE, None)
        temp_cred_sb = None
        if not from_sb and old and old.get("snapshot") and old.get("team") == cfg["team"] and old.get("project") == cfg["project"]:
            temp_cred_sb = "fxs-cred-" + uuid.uuid4().hex[:6]
            say(f"carrying over logins from previous base {old['snapshot']}")
            rc = subprocess.call(
                vc_args(cfg, "create", "--name", temp_cred_sb, "--snapshot", old["snapshot"], "--vcpus", "2", "--timeout", "5m"),
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if rc == 0:
                from_sb = temp_cred_sb
            else:
                temp_cred_sb = None

        base_name = "fxs-base-" + uuid.uuid4().hex[:6]
        with tempfile.TemporaryDirectory() as tmp:
            profile_tgz, profile_hash = build_profile_bundle(tmp, cfg)
            skills_tgz = build_skills_bundle(tmp)
            creds_tgz = export_creds_from(cfg, from_sb, tmp) if from_sb else None
            if temp_cred_sb:
                subprocess.run(vc_args(cfg, "rm", temp_cred_sb), capture_output=True)

            say(f"creating base sandbox {base_name} in {cfg['team']}/{cfg['project']}")
            run_vc(cfg, "create", "--name", base_name, "--vcpus", str(cfg.get("vcpus", "8")), "--timeout", "1h", "--tag", "fxs=base")
            run_vc(cfg, "copy", str(profile_tgz), f"{base_name}:/tmp/fxs-profile.tgz", capture=True)
            run_vc(cfg, "copy", str(skills_tgz), f"{base_name}:/tmp/fxs-skills.tgz", capture=True)
            if creds_tgz:
                run_vc(cfg, "copy", str(creds_tgz), f"{base_name}:/tmp/fxs-creds.tgz", capture=True)

        script = build_base_setup_script(cfg, agents)
        remote_exec(cfg, base_name, script, interactive=sys.stdin.isatty())

        say("snapshotting base image")
        p = run_vc(cfg, "snapshot", "--stop", "--expiration", "0", base_name, capture=True)
        m = re.search(r"snap_[A-Za-z0-9]+", p.stdout + p.stderr)
        if not m:
            die("could not find snapshot ID in output")
        snap_id = m.group(0)
        subprocess.run(vc_args(cfg, "rm", base_name), capture_output=True)

        write_json(BASE_FILE, {
            "snapshot": snap_id,
            "created": time.time(),
            "profile_hash": profile_hash,
            "team": cfg["team"],
            "project": cfg["project"],
            "agents": agents,
        })
        say(f"base snapshot {snap_id} is ready")


def ensure_base(cfg):
    base = read_json(BASE_FILE, None)
    if not base or base.get("team") != cfg["team"] or base.get("project") != cfg["project"]:
        say("no base snapshot found yet; building one now")
        cmd_base([])
        base = read_json(BASE_FILE, None)
    return base


def sync_profile_if_needed(cfg, name, base_hash):
    with tempfile.TemporaryDirectory() as tmp:
        profile_tgz, current_hash = build_profile_bundle(tmp, cfg)
        if current_hash == base_hash:
            return
        say("syncing updated local agent config/theme")
        run_vc(cfg, "copy", str(profile_tgz), f"{name}:/tmp/fxs-profile.tgz", capture=True)
        remote_exec(cfg, name, "tar -xzf /tmp/fxs-profile.tgz -C ~ && rm -f /tmp/fxs-profile.tgz", capture=True)


def rename_rex_block(label):
    block = os.environ.get("REX_BLOCK")
    if not block or not shutil.which("rex"):
        return
    subprocess.run(["rex", "block", "rename", block, label], capture_output=True)


