    cfg = require_config()
    run_vc(cfg, "rm", *args)
    for n in args:
        update_sandbox_record(n, managed=False)
    sync_ssh_config(cfg)


def main(argv):
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if not shutil.which("vercel"):
        die("vercel CLI not found")

    if not argv:
        return cmd_new([])

    sub = argv[0]
    if sub in ("init", "setup"):
        return cmd_init(argv[1:])
    if sub == "base":
        return cmd_base(argv[1:])
    if sub == "group":
        return cmd_group(argv[1:])
    if sub == "mcp-login":
        return cmd_mcp_login(argv[1:])
    if sub == "pull":
        return cmd_pull(argv[1:])
    if sub == "local":
        return cmd_local(argv[1:])
    if sub == "watchdog":
        return cmd_watchdog(argv[1:])
    if sub == "ssh":
        return cmd_ssh(argv[1:])
    if sub == "fit":
        return cmd_fit(argv[1:])
    if sub == "tailscale-key":
        return cmd_tailscale_key(argv[1:])
    if sub == "termius-csv":
        return cmd_termius_csv(argv[1:])
    if sub == "signing-setup":
        return cmd_signing_setup(argv[1:])
    if sub == "agents":
        return cmd_agents(argv[1:])
    if sub == "name":
        return cmd_name(argv[1:])
    if sub in ("resume", "r"):
        return cmd_resume(argv[1:])
    if sub == "shell":
        return cmd_shell(argv[1:])
    if sub in ("ls", "list"):
        return cmd_ls(argv[1:])
    if sub == "stop":
        return cmd_stop(argv[1:])
    if sub in ("rm", "remove"):
        return cmd_rm(argv[1:])
    return cmd_new(argv)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]) or 0)
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(130)
