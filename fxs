    if git_name:
        lines.append(f"git config --global user.name {shlex.quote(git_name)}")
    if git_email:
        lines.append(f"git config --global user.email {shlex.quote(git_email)}")
    lines.append("git config --global init.defaultBranch main")
    lines.append("git config --global push.autoSetupRemote true")

    for shim in selected:
        lines.append(
            f'if ! ({shim.auth_check_cmd}); then '
