#!/usr/bin/env python3
"""fxs: run persistent coding agents (fx, claude, codex, opencode, or custom shims) in Vercel Sandboxes.

Usage:
  fxs init [--yes] [--team T] [--project P] [--agent A] ...   first-time onboarding (interactive or agent-friendly)
  fxs [--agent A] [--name N] [--timeout 6h] [-- <args...>]     create a sandbox (fxs-1, fxs-2, ...) and run the agent
  fxs --split [--agent A] [-- <args...>]                       open a new sandbox in a Rex pane beside this one
  fxs group N [--workspace [LABEL]] [--agent A]                open N sandboxes side by side in Rex
  fxs resume [NAME|SLOT|ID|TITLE] [-- <args...>]               wake/reattach by sandbox, slot #, session ID, or title
  fxs name SANDBOX ALIAS                                       pin a custom nickname for a sandbox
  fxs pull NAME [--list | --all | PATH...] [--dest DIR]        sync sessions & pick files from a sandbox
  fxs local [ID]                                               list pulled fx sessions, or resume ID locally
  fxs watchdog [status|stop]                                   check or stop the idle auto-stop watchdog
  fxs ssh NAME                                                 enable Tailscale SSH on an existing sandbox
  fxs fit [NAME]                                               snap sandbox PTY size back to your local terminal
  fxs tailscale-key                                            save a reusable Tailscale auth key (auto-enables SSH)
  fxs termius-csv [COUNT] [--out FILE]                         export Termius CSV for 1..COUNT slots (default: 100)
  fxs signing-setup [--sandbox NAME]                           enable SSH commit signing in base (or one sandbox)
  fxs mcp-login NAME... [--sandbox S]                          sign in to HTTP MCPs via your local browser
  fxs agents [list|add]                                        list built-in and custom agent shims
  fxs ls [--all] [--raw]                                       list sandboxes with live session titles (100+ paginated)
  fxs stop NAME...                                             stop sandboxes (keeps disk, pauses billing)
  fxs rm NAME...                                               permanently remove sandboxes
  fxs shell NAME                                               open bash in an existing sandbox
  fxs base [--from SANDBOX] [--no-warm]                        build or rebuild the base snapshot
"""
