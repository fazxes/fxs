def watchdog_running():
    if not WATCHDOG_PID_FILE.exists():
        return None
    try:
        pid = int(WATCHDOG_PID_FILE.read_text().strip())
        os.kill(pid, 0)
        return pid
    except Exception:
        return None


def ensure_watchdog(cfg):
    idle_min = int(os.environ.get("FXS_IDLE_MINUTES", str(cfg.get("idle_minutes", 30))))
    if idle_min <= 0 or watchdog_running():
        return
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    log_f = open(WATCHDOG_LOG_FILE, "a")
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "watchdog", "__run"],
        stdin=subprocess.DEVNULL,
        stdout=log_f,
        stderr=log_f,
        start_new_session=True,
        close_fds=True,
    )
    log_f.close()


def parse_timeout_left_s(line):
    m = re.search(r"\bin\s+(\d+)\s+(second|minute|hour|day)s?\b", line)
    if not m:
        return None
    n = int(m.group(1))
    mult = {"second": 1, "minute": 60, "hour": 3600, "day": 86400}[m.group(2)]
    return n * mult


def run_watchdog_daemon():
    cfg = read_config()
    idle_min = max(0, int(os.environ.get("FXS_IDLE_MINUTES", str(cfg.get("idle_minutes", 30)))))
    if idle_min <= 0 or not cfg.get("team"):
        return
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    lock_f = open(WATCHDOG_LOCK_FILE, "w")
    try:
        fcntl.flock(lock_f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    WATCHDOG_PID_FILE.write_text(str(os.getpid()) + "\n")
    try:
        while True:
            time.sleep(60)
            data = read_sandboxes()
            managed = [n for n, r in data.items() if r.get("managed")]
            if not managed:
                break

            p = subprocess.run(vc_args(cfg, "ls"), capture_output=True, text=True)
            if p.returncode != 0:
                continue
            running_timeouts = {}
            for line in p.stdout.splitlines():
                parts = line.split()
                if len(parts) >= 2 and parts[1] == "running":
                    running_timeouts[parts[0]] = parse_timeout_left_s(line)

            now = time.time()
            for name in managed:
                if name not in running_timeouts:
                    update_sandbox_record(name, managed=False)
                    continue
                rec = read_sandboxes().get(name, {})
                agent_name = rec.get("agent", cfg.get("default_agent", "fx"))
                pr = subprocess.run(
                    vc_args(cfg, "exec", name, "--", "python3", "-c", REMOTE_PROBE_ACTIVITY_PY, agent_name),
                    capture_output=True, text=True,
                )
                if pr.returncode != 0:
                    continue
                try:
                    info = json.loads(pr.stdout.strip().splitlines()[-1])
                except Exception:
                    continue

                sid = info.get("session_id") or rec.get("session_id")
                title = info.get("title") or rec.get("title")
                if sid:
                    update_sandbox_record(name, session_id=sid, title=title)

                last_active = float(rec.get("last_active") or now)
                log_mtime = float(info.get("last_log_mtime") or 0.0)
                if log_mtime > last_active:
                    last_active = log_mtime
                if info.get("working"):
                    last_active = now
                    update_sandbox_record(name, last_active=last_active)
                    left_s = running_timeouts.get(name)
                    if left_s is not None and left_s < 3600:
                        subprocess.run(vc_args(cfg, "extend", name, "2h"), capture_output=True)
                    continue
                update_sandbox_record(name, last_active=last_active)

                if now - last_active < idle_min * 60:
                    continue

                sync_sessions_back(cfg, name, agent_name)
                if info.get("agent_alive") and info.get("pids"):
                    pids_str = " ".join(info["pids"])
                    subprocess.run(
                        vc_args(cfg, "exec", name, "--", "bash", "-lc",
                                f"kill -INT {pids_str} 2>/dev/null || true; sleep 1; "
                                f"kill -INT {pids_str} 2>/dev/null || true; sleep 2"),
                        capture_output=True,
                    )
                st = subprocess.run(vc_args(cfg, "stop", name), capture_output=True, text=True)
                if st.returncode == 0:
                    update_sandbox_record(name, managed=False, stopped_reason="idle", stopped_at=now)
    finally:
        with contextlib.suppress(OSError):
            WATCHDOG_PID_FILE.unlink()
        fcntl.flock(lock_f.fileno(), fcntl.LOCK_UN)
        lock_f.close()


def run_agent_loop(cfg, name, agent_name, agent_args, continue_first=False, resume_id=None):
    shim = get_shim(agent_name, cfg)
    rename_rex_block(name)
    update_sandbox_record(name, agent=agent_name, managed=True, last_active=time.time(), stopped_reason=None)
    ensure_watchdog(cfg)

    first = True
    exited = False
    while True:
        use_continue = continue_first or (not first)
        cmd = shim.launch_command(agent_args, resume_id=resume_id if use_continue else None, continue_last=use_continue and not resume_id)
        exports = "".join(f"export {k}={shlex.quote(str(v))}; " for k, v in shim.extra_env.items())
        script = (
            'export PATH="$HOME/.local/bin:$HOME/.bun/bin:$HOME/.opencode/bin:/usr/local/bin:$PATH"; '
            f'{exports}exec dtach -A /tmp/fxs-agent.sock -E -z -r winch {cmd}'
        )
        rc = run_interactive_with_image_sync(cfg, name, script)
        first = False
        alive = remote_exec(
            cfg, name,
            "pgrep -f '/tmp/fxs-agent.sock' >/dev/null 2>&1 && echo ALIVE || echo GONE",
            check=False, capture=True,
        )
        still_running = alive.returncode == 0 and "ALIVE" in alive.stdout
        if not still_running and rc == 0:
            exited = True
            break
        print(file=sys.stderr)
        if still_running:
            say(f"connection to {name} dropped (exit {rc}); {agent_name} keeps running in the sandbox.")
            prompt_msg = "Press Enter to reattach, or 'q' to leave it running in the cloud: "
        else:
            say(f"connection/sandbox ended (exit {rc}); your files and session are saved on disk.")
            prompt_msg = "Press Enter to resume in a new session, or 'q' to quit: "
        try:
            ans = input(prompt_msg).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if ans == "q":
            if not still_running:
                exited = True
            break

    roots = sync_sessions_back(cfg, name, agent_name)
    if roots:
        update_sandbox_record(name, session_id=roots[0]["id"], title=roots[0]["title"])
    if not exited:
        say(f"{agent_name} is still running in {name}; reattach anytime with `fxs resume {name}`")
        return
    update_sandbox_record(name, managed=False)
    if sys.stdin.isatty():
        prompt_keep_files(cfg, name)
        try:
            action = input(f"Sandbox {name}: [k]eep running, [s]top (pause billing), [r]emove (default: k): ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
            action = "k"
        if action in ("s", "stop"):
            run_vc(cfg, "stop", name)
            return
        if action in ("r", "rm", "remove"):
            run_vc(cfg, "rm", name)
            return
    say(f"sandbox {name}: resume with `fxs resume {name}` | stop with `fxs stop {name}` | remove with `fxs rm {name}`")


